+void CJitter::AssociateSymbolsToLocals(SymbolRegAllocInfo& symbolRegAllocs)
+{
+	//WebAssembly has no register file to run out of: a function's locals are the registers, and the
+	//engine allocates machine registers for them. Every relative symbol used more than once in the range
+	//gets a temporary (a local) of its own, loaded at the start of the range and written back at its end
+	//like a register would be, so guest registers stop going through linear memory at every use.
+	for(auto& symbolRegAllocPair : symbolRegAllocs)
+	{
+		const auto& symbol = symbolRegAllocPair.first;
+		auto& symbolRegAlloc = symbolRegAllocPair.second;
+		if(symbolRegAlloc.aliased) continue;
+		if(symbolRegAlloc.useCount < 2) continue;
+		SYM_TYPE localType = SYM_TEMPORARY;
+		switch(symbol->m_type)
+		{
+		case SYM_RELATIVE:
+			localType = SYM_TEMPORARY;
+			break;
+		case SYM_RELATIVE64:
+			localType = SYM_TEMPORARY64;
+			break;
+		case SYM_FP_RELATIVE32:
+			localType = SYM_FP_TEMPORARY32;
+			break;
+		case SYM_RELATIVE128:
+			localType = SYM_TEMPORARY128;
+			break;
+		case SYM_REL_REFERENCE:
+			//References are only read by generated code (there is no emitter to write one back)
+			if(symbolRegAlloc.firstDef != -1) continue;
+			localType = SYM_TMP_REFERENCE;
+			break;
+		default:
+			continue;
+		}
+		symbolRegAlloc.registerType = localType;
+		symbolRegAlloc.registerId = m_nextTemporary++;
+	}
+}
