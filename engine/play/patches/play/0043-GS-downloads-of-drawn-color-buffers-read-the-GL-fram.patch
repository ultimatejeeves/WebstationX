+//Debug: a watched block of GS memory (debugWatchGsBlock). Checked whenever a transfer starts; a change is
+//attributed to the transfer that started before (anything else that writes GS memory shows up as that too).
+uint32 g_wsxGsWatchBlock = ~0U;
+
+static void WsxGsWatchCheck(const uint8* ram, const char* next)
+{
+	static uint32 lastSum = 0;
+	static char lastDesc[200] = "(nothing yet)";
+	static uint32 count = 0;
+	uint32 sum = 0;
+	auto words = reinterpret_cast<const uint32*>(ram + (g_wsxGsWatchBlock * 256));
+	for(unsigned int i = 0; i < 64; i++)
+	{
+		sum = (sum * 31) + words[i];
+	}
+	if(sum != lastSum)
+	{
+		printf("GSWATCH block %X changed (#%u) after: %s | now %08X %08X %08X %08X\n", g_wsxGsWatchBlock, count, lastDesc, words[0], words[1], words[2], words[3]);
+		lastSum = sum;
+	}
+	count++;
+	if(next)
+	{
+		snprintf(lastDesc, sizeof(lastDesc), "#%u %s", count, next);
+	}
+}
