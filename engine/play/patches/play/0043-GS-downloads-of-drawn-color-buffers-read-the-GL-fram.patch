+// Debug: a texture as it sits in GS memory right now (read from the page thread while the GS runs: a snapshot).
+// psm: 0 CT32, 2 CT16, 0x13 T8, 0x14 T4. Returns the address of width*height uint32 (raw indices or colours).
+#include "../gs/GsPixelFormats.h"
+uintptr_t debugReadGsTexture(uint32 tbp, uint32 tbw, uint32 psm, uint32 width, uint32 height)
+{
+	static std::vector<uint32> pixels;
+	pixels.assign(width * height, 0);
+	auto gs = g_virtualMachine->GetGSHandler();
+	if(!gs) return 0;
+	auto ram = gs->GetRam();
+	uint32 pointer = tbp * 256;
+	uint32 bufWidth = tbw / 64;
+	auto read = [&](auto indexor) {
+		for(uint32 y = 0; y < height; y++)
+		{
+			for(uint32 x = 0; x < width; x++)
+			{
+				pixels[(y * width) + x] = indexor.GetPixel(x, y);
+			}
+		}
+	};
+	switch(psm)
+	{
+	case 0x13:
+		read(CGsPixelFormats::CPixelIndexorPSMT8(ram, pointer, bufWidth));
+		break;
+	case 0x14:
+		read(CGsPixelFormats::CPixelIndexorPSMT4(ram, pointer, bufWidth));
+		break;
+	case 0x02:
+		read(CGsPixelFormats::CPixelIndexorPSMCT16(ram, pointer, bufWidth));
+		break;
+	default:
+		read(CGsPixelFormats::CPixelIndexorPSMCT32(ram, pointer, bufWidth));
+		break;
+	}
+	return reinterpret_cast<uintptr_t>(pixels.data());
+}
+
+// Debug: report the GS transfers after which one block of GS memory changed (GSWATCH lines on the console).
+extern uint32 g_wsxGsWatchBlock;
+void debugWatchGsBlock(uint32 block)
+{
+	g_wsxGsWatchBlock = block;
+}
