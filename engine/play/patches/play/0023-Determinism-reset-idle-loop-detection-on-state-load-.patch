Subject: [PATCH 23/43] Determinism: reset idle loop detection on state load;
 debug hooks (EE block IR dump, locals switch, hash timing)

---
 Source/ee/Ee_SubSystem.cpp |  5 +++
 Source/ui_js/Main.cpp      | 68 ++++++++++++++++++++++++++++++++++++--
 2 files changed, 70 insertions(+), 3 deletions(-)

diff --git a/Source/ee/Ee_SubSystem.cpp b/Source/ee/Ee_SubSystem.cpp
index 460fab0a..0bbb4393 100644
--- a/Source/ee/Ee_SubSystem.cpp
+++ b/Source/ee/Ee_SubSystem.cpp
@@ -578,6 +578,11 @@ void CSubSystem::LoadState(Framework::CZipArchiveReader& archive)
 	m_gif.LoadState(archive);
 	m_ipu.LoadState(archive);
 	m_os->GetLibMc2().LoadState(archive);
+
+	//Not part of a state: what idle loop detection counted before the load would make the machine's
+	//behaviour after it depend on how long it ran before (WebStationX's determinism check relies on this).
+	m_statusRegisterCheckers.clear();
+	m_isIdle = false;
 }
 
 void CSubSystem::SetupEePageTable()
