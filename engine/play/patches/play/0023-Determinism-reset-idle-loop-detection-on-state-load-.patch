 #include "DefaultAppConfig.h"
 #include "AppConfig.h"
 #include "PS2VM_Preferences.h"
@@ -33,6 +37,7 @@ std::atomic<uint32> g_vblankCount = 0;
 // load, so two cores can be shown to emulate the same thing (setStateHashFrames, getStateHash).
 static uint32 g_stateHashFrames = 0;
 static uint32 g_stateHashTarget = 0;
+static double g_stateHashStart = 0;
 static std::string g_stateHash;
 static std::mutex g_stateHashMutex;
 
@@ -56,7 +61,8 @@ static void CheckStateHash()
 	result += "\"vu0Mem\":\"" + hash(ee->m_vuMem0, PS2::VUMEM0SIZE) + "\",";
 	result += "\"vu1Mem\":\"" + hash(ee->m_vuMem1, PS2::VUMEM1SIZE) + "\",";
 	result += "\"vu1Regs\":\"" + hash(ee->m_VU1.m_State.nCOP2, sizeof(ee->m_VU1.m_State.nCOP2)) + "\",";
-	result += "\"iopRam\":\"" + hash(iop->m_ram, PS2::IOP_RAM_SIZE) + "\"";
+	result += "\"iopRam\":\"" + hash(iop->m_ram, PS2::IOP_RAM_SIZE) + "\",";
+	result += "\"ms\":" + std::to_string(static_cast<int>(WsxFrameStats::Now() - g_stateHashStart));
 	result += "}";
 	{
 		std::lock_guard<std::mutex> lock(g_stateHashMutex);
@@ -291,7 +297,11 @@ void loadState(std::string path)
 {
 	g_stateOp = g_virtualMachine->LoadState(path);
 	g_virtualMachine->SendVmCall([]() {
-		if(g_stateHashFrames != 0) g_stateHashTarget = g_vblankCount.load() + g_stateHashFrames;
+		if(g_stateHashFrames != 0)
+		{
+			g_stateHashTarget = g_vblankCount.load() + g_stateHashFrames;
+			g_stateHashStart = WsxFrameStats::Now();
+		}
 	});
 }
 
@@ -308,7 +318,11 @@ void setStateHashFrames(uint32 frames)
 void armStateHash()
 {
 	g_virtualMachine->SendVmCall([]() {
-		if(g_stateHashFrames != 0) g_stateHashTarget = g_vblankCount.load() + g_stateHashFrames;
+		if(g_stateHashFrames != 0)
+		{
+			g_stateHashTarget = g_vblankCount.load() + g_stateHashFrames;
+			g_stateHashStart = WsxFrameStats::Now();
+		}
 	});
 }
 
@@ -430,6 +444,51 @@ uintptr_t getVmZoneAddress()
 	return reinterpret_cast<uintptr_t>(&WsxProfile::g_current);
 }
 
+// Debug: the Jitter's final statement list for the EE block starting at `address` (compiled again on the
+// VM thread, not installed). Request it, then take it once it's there.
+static std::string g_eeBlockDump;
+static std::mutex g_eeBlockDumpMutex;
+
+void debugRequestEeBlockDump(uint32 address)
+{
+	g_virtualMachine->SendVmCall([address]() {
+		std::string result;
+		auto& ee = g_virtualMachine->m_ee->m_EE;
+		auto executor = static_cast<CEeExecutor*>(ee.m_executor.get());
+		auto block = executor->FindBlockStartingAt(address);
+		if(!block || block->IsEmpty())
+		{
+			result = "no block";
+		}
+		else
+		{
+			CEeBasicBlock copy(ee, block->GetBeginAddress(), block->GetEndAddress(), BLOCK_CATEGORY_PS2_EE);
+			bool verify = WsxJitCache::g_verify;
+			WsxJitCache::g_verify = true; //compile even if cached
+			Jitter::g_statementDump = &result;
+			copy.Compile();
+			Jitter::g_statementDump = nullptr;
+			WsxJitCache::g_verify = verify;
+		}
+		std::lock_guard lock(g_eeBlockDumpMutex);
+		g_eeBlockDump = result;
+	});
+}
+
+// Debug: the Jitter's register allocation onto wasm locals (on by default), before booting.
+void debugSetLocalsAsRegisters(bool enabled)
+{
+	Jitter::g_wasmLocalsAsRegisters = enabled;
+}
+
+std::string debugTakeEeBlockDump()
+{
+	std::lock_guard lock(g_eeBlockDumpMutex);
+	std::string result;
+	result.swap(g_eeBlockDump);
+	return result;
+}
+
 // Same for the VPU1 thread (VIF1, VU1 and the GIF, CVpu1Thread).
 uintptr_t getVpu1ZoneAddress()
 {
@@ -487,6 +546,9 @@ EMSCRIPTEN_BINDINGS(Play)
 	function("getVpu1ZoneAddress", &getVpu1ZoneAddress);
 	function("setVpu1ThreadMode", &setVpu1ThreadMode);
 	function("getVpu1Stats", &getVpu1Stats);
+	function("debugRequestEeBlockDump", &debugRequestEeBlockDump);
+	function("debugTakeEeBlockDump", &debugTakeEeBlockDump);
+	function("debugSetLocalsAsRegisters", &debugSetLocalsAsRegisters);
 	function("setStateHashFrames", &setStateHashFrames);
 	function("getStateHash", &getStateHash);
 	function("armStateHash", &armStateHash);
