Subject: [PATCH 51/52] Restore SPU2 wrapper registers and pending source
 clocks

---
 Source/iop/Iop_Spu2.cpp      | 36 ++++++++++++++++++++++++++++++++++++
 Source/iop/Iop_Spu2.h        |  2 ++
 Source/iop/Iop_Spu2_Core.cpp |  5 +++++
 Source/iop/Iop_Spu2_Core.h   |  1 +
 Source/iop/Iop_SpuBase.cpp   |  7 ++++++-
 Source/iop/Iop_SpuBase.h     |  3 ++-
 Source/iop/Iop_SubSystem.cpp |  2 ++
 7 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/Source/iop/Iop_Spu2.cpp b/Source/iop/Iop_Spu2.cpp
index b7d0040f..5daa9f61 100644
--- a/Source/iop/Iop_Spu2.cpp
+++ b/Source/iop/Iop_Spu2.cpp
@@ -3,10 +3,12 @@
 #include "Iop_Spu2.h"
 #include "Log.h"
 #include "placeholder_def.h"
+#include "states/RegisterStateFile.h"
 
 #define LOG_NAME ("iop_spu2")
 
 #define SPDIF_OUT_BYPASS 0x0100
+#define STATE_REGS_PATH "iop_spu/spu2.xml"
 
 using namespace Iop;
 using namespace Iop::Spu2;
@@ -30,12 +32,46 @@ CSpu2::CSpu2(CSpuBase& spuBase0, CSpuBase& spuBase1)
 
 void CSpu2::Reset()
 {
+	m_spdifOutput = 0;
+	m_spdifMode = 0;
+	m_spdifMedia = 0;
+	m_core[0]->GetSpuBase().SetInputBypass(false);
 	for(unsigned int i = 0; i < CORE_NUM; i++)
 	{
 		m_core[i]->Reset();
 	}
 }
 
+void CSpu2::SaveState(Framework::CZipArchiveWriter& archive)
+{
+	auto state = std::make_unique<CRegisterStateFile>(STATE_REGS_PATH);
+	state->SetRegister32("SpdifOutput", m_spdifOutput);
+	state->SetRegister32("SpdifMode", m_spdifMode);
+	state->SetRegister32("SpdifMedia", m_spdifMedia);
+	state->SetRegister32("Core0BaseSamplingRate", m_core[0]->GetBaseSamplingRate());
+	state->SetRegister32("Core1BaseSamplingRate", m_core[1]->GetBaseSamplingRate());
+	archive.InsertFile(std::move(state));
+}
+
+void CSpu2::LoadState(Framework::CZipArchiveReader& archive)
+{
+	// Base cores must be restored first. Old archives only retained the bypass
+	// bit in their input state; all other omitted wrapper values use defaults.
+	m_spdifOutput = m_core[0]->GetSpuBase().GetInputBypass() ? SPDIF_OUT_BYPASS : 0;
+	m_spdifMode = 0;
+	m_spdifMedia = 0;
+	for(auto& core : m_core) core->Reset();
+	if(!archive.GetFileHeader(STATE_REGS_PATH)) return;
+	CRegisterStateFile state(*archive.BeginReadFile(STATE_REGS_PATH));
+	m_spdifOutput = state.GetRegister32("SpdifOutput");
+	m_spdifMode = state.GetRegister32("SpdifMode");
+	m_spdifMedia = state.GetRegister32("SpdifMedia");
+	m_core[0]->SetBaseSamplingRate(state.GetRegister32("Core0BaseSamplingRate"));
+	m_core[1]->SetBaseSamplingRate(state.GetRegister32("Core1BaseSamplingRate"));
+	// Do not replay register writes: CORE_ATTR would apply the pending clock,
+	// and the base cores have already restored their exact input-buffer state.
+}
+
 CCore* CSpu2::GetCore(unsigned int coreId)
 {
 	assert(coreId < CORE_NUM);
