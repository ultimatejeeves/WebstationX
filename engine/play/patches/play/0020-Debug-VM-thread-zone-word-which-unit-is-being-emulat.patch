diff --git a/Source/WsxProfile.h b/Source/WsxProfile.h
new file mode 100644
index 00000000..95f5556a
--- /dev/null
+++ b/Source/WsxProfile.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <atomic>
+#include "Types.h"
+
+//Where the VM thread's time goes (WebStationX): the unit being emulated right now is kept in one word
+//of shared memory, and the page samples it from another thread (cheap enough to leave on: timing each
+//unit with the clock costs a JS call per read on the web, which made the measured units twice as slow).
+namespace WsxProfile
+{
+	enum ZONE : uint32
+	{
+		ZONE_OTHER,
+		ZONE_EE,
+		ZONE_VU0,
+		ZONE_VIF0,
+		ZONE_VIF1,
+		ZONE_VU1,
+		ZONE_GIF,
+		ZONE_IPU,
+		ZONE_IOP,
+		ZONE_SPU,
+		ZONE_JIT,
+		ZONE_WAIT, //blocked on the GS thread or the disc
+		ZONE_COUNT,
+	};
+
+	inline std::atomic<uint32> g_current = ZONE_OTHER;
+
+	class CZone
+	{
+	public:
+		explicit CZone(ZONE zone)
+		    : m_saved(g_current.load(std::memory_order_relaxed))
+		{
+			g_current.store(zone, std::memory_order_relaxed);
+		}
+
+		~CZone()
+		{
+			g_current.store(m_saved, std::memory_order_relaxed);
+		}
+
+	private:
+		uint32 m_saved;
+	};
+}
