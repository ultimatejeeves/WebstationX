From 63f2ddb22a440b92893cd45a4ab71be150e6860a Mon Sep 17 00:00:00 2001
From: ultimatejeeves <ultimatejeeves@users.noreply.github.com>
Date: Sun, 4 Oct 2026 13:36:52 -0400
Subject: [PATCH 48/48] Use truncated SIMD multiplication for Wasm CPU blocks

---
 Source/BasicBlock.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Source/BasicBlock.cpp b/Source/BasicBlock.cpp
index 0ffbe76b..443ce398 100644
--- a/Source/BasicBlock.cpp
+++ b/Source/BasicBlock.cpp
@@ -7,6 +7,9 @@
 #include "offsetof_def.h"
 #include "MipsJitter.h"
 #include "Jitter_CodeGenFactory.h"
+#ifdef __EMSCRIPTEN__
+#include "Jitter_CodeGen_Wasm.h"
+#endif
 
 #if defined(AOT_BUILD_CACHE) || defined(AOT_USE_CACHE)
 #define AOT_ENABLED
@@ -157,6 +160,9 @@ void CBasicBlock::Compile()
 		if(jitter == nullptr)
 		{
 			Jitter::CCodeGen* codeGen = Jitter::CreateCodeGen();
+#ifdef __EMSCRIPTEN__
+			static_cast<Jitter::CCodeGen_Wasm*>(codeGen)->SetTruncateFloatMultiply(true);
+#endif
 			jitter = new CMipsJitter(codeGen);
 		}
 
