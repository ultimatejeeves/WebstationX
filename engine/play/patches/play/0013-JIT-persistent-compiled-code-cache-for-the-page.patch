--- a/Source/BasicBlock.cpp
+++ b/Source/BasicBlock.cpp
@@ -1,5 +1,7 @@
 #include "BasicBlock.h"
 #include "WsxFrameStats.h"
+#include "WsxJitCache.h"
+#include "xxhash.h"
 #include "MemStream.h"
 #include "offsetof_def.h"
 #include "MipsJitter.h"
@@ -86,9 +88,53 @@ void CBasicBlock::SetAotBlockOutputStream(Framework::CStdStream* outputStream)
 
 #endif
 
+#ifdef __EMSCRIPTEN__
+static WsxJitCache::KEY ComputeCacheKey(CMIPS& context, uint32 begin, uint32 end, uint32 category, uint32 hints, uint64 salt)
+{
+	std::vector<uint32> words;
+	words.reserve(((end - begin) / 4) + 1 + 6);
+	for(uint32 address = begin; address <= end; address += 4)
+	{
+		words.push_back(context.m_pMemoryMap->GetInstruction(address));
+	}
+	words.push_back(begin);
+	words.push_back(end);
+	words.push_back(category);
+	words.push_back(hints);
+	words.push_back(static_cast<uint32>(salt));
+	words.push_back(static_cast<uint32>(salt >> 32));
+	auto hash = XXH3_128bits(words.data(), words.size() * sizeof(uint32));
+	WsxJitCache::KEY key;
+	key.lo = hash.low64;
+	key.hi = hash.high64;
+	return key;
+}
+#endif
+
 void CBasicBlock::Compile()
 {
 	WsxFrameStats::CScope compileScope(WsxFrameStats::g_jitUs);
+#ifdef __EMSCRIPTEN__
+	bool cacheable = !IsEmpty() && IsCompileCacheable() && (m_category != BLOCK_CATEGORY_UNKNOWN);
+	WsxJitCache::KEY cacheKey;
+	const WsxJitCache::ENTRY* cached = nullptr;
+	if(cacheable)
+	{
+		cacheKey = ComputeCacheKey(m_context, m_begin, m_end, m_category, m_blockCompileHints, GetCompileSalt());
+		cached = WsxJitCache::Find(cacheKey);
+		if(cached && !WsxJitCache::g_verify)
+		{
+			WsxJitCache::g_stats.hits++;
+			for(uint32 i = 0; i < LINK_SLOT_MAX; i++)
+			{
+				m_linkBlockTrampolineOffset[i] = cached->linkOffsets[i];
+			}
+			CMemoryFunction::SetNextWasmLinkBase(reinterpret_cast<uintptr_t>(m_wasmLinkSlots));
+			m_function = CMemoryFunction(cached->code, cached->size);
+			return;
+		}
+	}
+#endif
 #ifndef AOT_USE_CACHE
 
 	Framework::CMemStream stream;
@@ -112,6 +158,25 @@ void CBasicBlock::Compile()
 	}
 
 #ifdef __EMSCRIPTEN__
+	if(cacheable)
+	{
+		auto size = static_cast<uint32>(stream.GetSize());
+		if(cached)
+		{
+			bool same = (cached->size == size) && !memcmp(cached->code, stream.GetBuffer(), size);
+			for(uint32 i = 0; i < LINK_SLOT_MAX; i++)
+			{
+				same &= (cached->linkOffsets[i] == m_linkBlockTrampolineOffset[i]);
+			}
+			if(!same) WsxJitCache::g_stats.mismatches++;
+			WsxJitCache::g_stats.hits++;
+		}
+		else
+		{
+			WsxJitCache::g_stats.misses++;
+			WsxJitCache::Record(cacheKey, stream.GetBuffer(), size, m_linkBlockTrampolineOffset);
+		}
+	}
 	CMemoryFunction::SetNextWasmLinkBase(reinterpret_cast<uintptr_t>(m_wasmLinkSlots));
 #endif
 	m_function = CMemoryFunction(stream.GetBuffer(), stream.GetSize());
