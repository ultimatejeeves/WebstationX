diff --git a/Source/WsxJitCache.h b/Source/WsxJitCache.h
new file mode 100644
index 00000000..4c5f3510
--- /dev/null
+++ b/Source/WsxJitCache.h
@@ -0,0 +1,112 @@
+#pragma once
+
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+#include "Types.h"
+
+//Persistent cache of compiled guest code (WebStationX). Compiling a block is mostly the Jitter front end
+//(~2/3 of the cost) and V8 compiling the resulting wasm module (~1/3). The page keeps what the Jitter
+//produced, per game and core build, and hands it back on the next launch: a block whose key is known
+//skips the Jitter. The key covers everything that shapes a block's code: its instructions, address
+//range, category, compile hints and the block type's own inputs (CBasicBlock::GetCompileSalt).
+//
+//Blob format (the page stores and returns it verbatim): entries of
+//  KEY (16 bytes) | uint32 size | uint32 linkOffsets[2] | size bytes of wasm | padding to 4 bytes
+namespace WsxJitCache
+{
+	struct KEY
+	{
+		uint64 lo = 0;
+		uint64 hi = 0;
+		bool operator==(const KEY& rhs) const
+		{
+			return (lo == rhs.lo) && (hi == rhs.hi);
+		}
+	};
+
+	struct KEY_HASH
+	{
+		size_t operator()(const KEY& key) const
+		{
+			return static_cast<size_t>(key.lo ^ (key.hi * 0x9E3779B97F4A7C15ULL));
+		}
+	};
+
+	struct ENTRY
+	{
+		const uint8* code = nullptr;
+		uint32 size = 0;
+		uint32 linkOffsets[2] = {};
+	};
+
+	struct STATS
+	{
+		uint32 hits = 0;
+		uint32 misses = 0;
+		uint32 mismatches = 0; //verify mode: the cached code differs from a fresh compile
+		uint32 loaded = 0;
+	};
+
+	//Loaded entries: filled and read on the VM thread only.
+	inline std::unordered_map<KEY, ENTRY, KEY_HASH> g_entries;
+	inline STATS g_stats;
+	inline bool g_verify = false;
+
+	//New entries since the page last took them (VM thread appends, main thread takes).
+	inline std::vector<uint8> g_pending;
+	inline std::mutex g_pendingMutex;
+
+	enum
+	{
+		HEADER_SIZE = 16 + 4 + 8,
+	};
+
+	//VM thread. The blob must outlive the cache (it's never freed).
+	inline void Load(const uint8* blob, uint32 size)
+	{
+		uint32 pos = 0;
+		while((pos + HEADER_SIZE) <= size)
+		{
+			KEY key;
+			ENTRY entry;
+			memcpy(&key, blob + pos, 16);
+			memcpy(&entry.size, blob + pos + 16, 4);
+			memcpy(entry.linkOffsets, blob + pos + 20, 8);
+			pos += HEADER_SIZE;
+			if((pos + entry.size) > size) break;
+			entry.code = blob + pos;
+			pos += (entry.size + 3) & ~3;
+			g_entries[key] = entry;
+		}
+		g_stats.loaded = static_cast<uint32>(g_entries.size());
+	}
+
+	inline const ENTRY* Find(const KEY& key)
+	{
+		auto it = g_entries.find(key);
+		return (it == g_entries.end()) ? nullptr : &it->second;
+	}
+
+	inline void Record(const KEY& key, const void* code, uint32 size, const uint32* linkOffsets)
+	{
+		std::lock_guard lock(g_pendingMutex);
+		size_t pos = g_pending.size();
+		g_pending.resize(pos + HEADER_SIZE + ((size + 3) & ~3), 0);
+		auto out = g_pending.data() + pos;
+		memcpy(out, &key, 16);
+		memcpy(out + 16, &size, 4);
+		memcpy(out + 20, linkOffsets, 8);
+		memcpy(out + HEADER_SIZE, code, size);
+	}
+
+	//Main thread.
+	inline std::vector<uint8> TakePending()
+	{
+		std::lock_guard lock(g_pendingMutex);
+		std::vector<uint8> result;
+		result.swap(g_pending);
+		return result;
+	}
+}
