--- /dev/null
+++ b/Source/gs/GsTransferFast.h
@@ -0,0 +1,120 @@
+#pragma once
+
+// Row/page-run based host->local transfer writers (WebStationX).
+//
+// The reference handlers in CGSHandler compute a full swizzled address for every pixel (page number,
+// modulo, table lookup) and for PSMT4 do a read-modify-write through the column tables twice per pixel.
+// These walk each transfer row in runs that stay inside one GS page, so the page base is computed once
+// per run and the inner loop is a table lookup + store. Results are bit-identical to the reference
+// (see tools/ps2/transfer-test.cpp in WebStationX).
+
+#include <algorithm>
+#include "Types.h"
+#include "GsPixelFormats.h"
+
+namespace GsTransferFast
+{
+	struct Rect
+	{
+		uint32 dstPtr;   // byte address in GS RAM
+		uint32 dstWidth; // in units of 64 pixels (BITBLTBUF.DBW)
+		uint32 dsax;
+		uint32 dsay;
+		uint32 rrw;
+	};
+
+	// Writes `count` pixels. rrx/rry is the transfer cursor (TRXCONTEXT) and is advanced.
+	template <typename Storage>
+	bool WriteGeneric(uint8* ram, const Rect& rect, uint32& rrx, uint32& rry, const typename Storage::Unit* src, uint32 count)
+	{
+		typedef typename Storage::Unit Unit;
+		enum
+		{
+			PW = Storage::PAGEWIDTH,
+			PH = Storage::PAGEHEIGHT
+		};
+		const auto pageOffsets = reinterpret_cast<const uint32*>(CGsPixelFormats::CPixelIndexor<Storage>::GetPageOffsets());
+		const uint32 ramMask = CGSHandler::RAMSIZE - 1;
+		uint32 dirty = 0;
+		uint32 i = 0;
+		while(i < count)
+		{
+			uint32 x = (rrx + rect.dsax) % 2048;
+			uint32 y = (rry + rect.dsay) % 2048;
+			uint32 rowLeft = (rrx < rect.rrw) ? (rect.rrw - rrx) : ~0U;
+			uint32 run = std::min<uint32>(count - i, rowLeft);
+			run = std::min<uint32>(run, PW - (x % PW));
+			run = std::min<uint32>(run, 2048 - x);
+			// Same evaluation order as CPixelIndexor (matters for odd buffer widths).
+			uint32 pageNum = (x / PW) + ((y / PH) * (rect.dstWidth * 64)) / PW;
+			uint32 base = rect.dstPtr + pageNum * CGsPixelFormats::PAGESIZE;
+			const uint32* rowOffsets = pageOffsets + (y % PH) * PW + (x % PW);
+			const Unit* s = src + i;
+			for(uint32 k = 0; k < run; k++)
+			{
+				auto pixel = reinterpret_cast<Unit*>(ram + ((base + rowOffsets[k]) & ramMask));
+				Unit value = s[k];
+				dirty |= (*pixel != value);
+				*pixel = value;
+			}
+			i += run;
+			rrx += run;
+			if(rrx == rect.rrw)
+			{
+				rrx = 0;
+				rry++;
+			}
+		}
+		return dirty != 0;
+	}
+
+	// PSMT4: `byteCount` bytes, two pixels per byte (low nibble first).
+	inline bool WritePSMT4(uint8* ram, const Rect& rect, uint32& rrx, uint32& rry, const uint8* src, uint32 byteCount)
+	{
+		typedef CGsPixelFormats::STORAGEPSMT4 Storage;
+		enum
+		{
+			PW = Storage::PAGEWIDTH,
+			PH = Storage::PAGEHEIGHT
+		};
+		// Nibble offsets within a page (see CPixelIndexor<STORAGEPSMT4>::BuildPageOffsetTable).
+		const auto pageOffsets = reinterpret_cast<const uint32*>(CGsPixelFormats::CPixelIndexorPSMT4::GetPageOffsets());
+		const uint32 ramMask = CGSHandler::RAMSIZE - 1;
+		const uint32 count = byteCount * 2;
+		uint32 dirty = 0;
+		uint32 i = 0;
+		while(i < count)
+		{
+			uint32 x = (rrx + rect.dsax) % 2048;
+			uint32 y = (rry + rect.dsay) % 2048;
+			uint32 rowLeft = (rrx < rect.rrw) ? (rect.rrw - rrx) : ~0U;
+			uint32 run = std::min<uint32>(count - i, rowLeft);
+			run = std::min<uint32>(run, PW - (x % PW));
+			run = std::min<uint32>(run, 2048 - x);
+			// Same evaluation order as CPixelIndexor (matters for odd buffer widths).
+			uint32 pageNum = (x / PW) + ((y / PH) * (rect.dstWidth * 64)) / PW;
+			uint32 base = rect.dstPtr + pageNum * CGsPixelFormats::PAGESIZE;
+			const uint32* rowOffsets = pageOffsets + (y % PH) * PW + (x % PW);
+			for(uint32 k = 0; k < run; k++)
+			{
+				uint32 p = i + k;
+				uint8 value = (src[p >> 1] >> ((p & 1) * 4)) & 0x0F;
+				uint32 nibble = rowOffsets[k];
+				uint8* byte = ram + ((base + (nibble >> 1)) & ramMask);
+				uint32 shift = (nibble & 1) * 4;
+				uint8 old = *byte;
+				uint8 updated = static_cast<uint8>((old & ~(0x0F << shift)) | (value << shift));
+				dirty |= (old != updated);
+				*byte = updated;
+			}
+			i += run;
+			rrx += run;
+			if(rrx == rect.rrw)
+			{
+				rrx = 0;
+				rry++;
+			}
+		}
+		return dirty != 0;
+	}
+}
