+//Runs fn with the pixel indexor of a pixel storage format (false for formats without one).
+template <typename Function>
+static bool WithPixelIndexor(uint32 psm, uint8* ram, uint32 bufPtr, uint32 bufWidth, Function&& fn)
+{
+	switch(psm)
+	{
+	case CGSHandler::PSMCT32:
+	case CGSHandler::PSMCT24:
+	case CGSHandler::PSMCT24_UNK:
+	case CGSHandler::PSMCT32_UNK:
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT32 indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMZ32:
+	case CGSHandler::PSMZ24:
+	{
+		CGsPixelFormats::CPixelIndexorPSMZ32 indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMCT16:
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT16 indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMCT16S:
+	{
+		CGsPixelFormats::CPixelIndexorPSMCT16S indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMZ16:
+	{
+		CGsPixelFormats::CPixelIndexor<CGsPixelFormats::STORAGEPSMZ16> indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMZ16S:
+	{
+		CGsPixelFormats::CPixelIndexorPSMZ16S indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMT8:
+	{
+		CGsPixelFormats::CPixelIndexorPSMT8 indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	case CGSHandler::PSMT4:
+	{
+		CGsPixelFormats::CPixelIndexorPSMT4 indexor(ram, bufPtr, bufWidth);
+		fn(indexor);
+	}
+		return true;
+	default:
+		return false;
+	}
+}
