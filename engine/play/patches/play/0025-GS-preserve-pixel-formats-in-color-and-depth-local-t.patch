+//Writes the depth values of a depth texture as the bytes of the 32-bit Z value they were drawn with
+//(depth = z / 2^32, see the vertex shader), one output pixel per guest pixel.
+Framework::OpenGl::ProgramPtr CGSH_OpenGL::GenerateDepthReadProgram()
+{
+	Framework::OpenGl::CShader vertexShader(GL_VERTEX_SHADER);
+	Framework::OpenGl::CShader pixelShader(GL_FRAGMENT_SHADER);
+
+	{
+		std::stringstream shaderBuilder;
+		shaderBuilder << GLSL_VERSION << std::endl;
+		shaderBuilder << "in vec2 a_position;" << std::endl;
+		shaderBuilder << "void main()" << std::endl;
+		shaderBuilder << "{" << std::endl;
+		shaderBuilder << "	gl_Position = vec4(a_position, 0, 1);" << std::endl;
+		shaderBuilder << "}" << std::endl;
+
+		vertexShader.SetSource(shaderBuilder.str().c_str());
+		FRAMEWORK_MAYBE_UNUSED bool result = vertexShader.Compile();
+		assert(result);
+	}
+
+	{
+		std::stringstream shaderBuilder;
+		shaderBuilder << GLSL_VERSION << std::endl;
+		shaderBuilder << "precision highp float;" << std::endl;
+		shaderBuilder << "precision highp int;" << std::endl;
+		shaderBuilder << "out vec4 fragColor;" << std::endl;
+		shaderBuilder << "uniform highp sampler2D g_texture;" << std::endl;
+		shaderBuilder << "uniform ivec2 g_origin;" << std::endl;
+		shaderBuilder << "uniform int g_scale;" << std::endl;
+		shaderBuilder << "void main()" << std::endl;
+		shaderBuilder << "{" << std::endl;
+		shaderBuilder << "	ivec2 coord = (ivec2(gl_FragCoord.xy) * g_scale) + g_origin;" << std::endl;
+		shaderBuilder << "	highp float depth = texelFetch(g_texture, coord, 0).r;" << std::endl;
+		shaderBuilder << "	highp uint z = (depth >= 1.0) ? 0xFFFFFFFFu : uint(max(depth, 0.0) * 4294967296.0);" << std::endl;
+		shaderBuilder << "	fragColor = vec4(float(z & 0xFFu), float((z >> 8) & 0xFFu), float((z >> 16) & 0xFFu), float(z >> 24)) / 255.0;" << std::endl;
+		shaderBuilder << "}" << std::endl;
+
+		pixelShader.SetSource(shaderBuilder.str().c_str());
+		FRAMEWORK_MAYBE_UNUSED bool result = pixelShader.Compile();
+		assert(result);
+	}
+
+	auto program = std::make_shared<Framework::OpenGl::CProgram>();
+
+	{
+		program->AttachShader(vertexShader);
+		program->AttachShader(pixelShader);
+
+		glBindAttribLocation(*program, static_cast<GLuint>(PRIM_VERTEX_ATTRIB::POSITION), "a_position");
+
+		FRAMEWORK_MAYBE_UNUSED bool result = program->Link();
+		assert(result);
+	}
+
+	return program;
+}
