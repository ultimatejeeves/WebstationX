+//Pixels of a guest buffer as the GS would hold them, read from the color or depth buffer we drew them in.
+//Returns false when the area isn't one of our buffers (GS memory has it then).
+bool CGSH_OpenGL::ReadGlPixels(uint32 bufPtr, uint32 bufWidth, uint32 psm, uint32 x, uint32 y, uint32 width, uint32 height, std::vector<uint32>& pixels)
+{
+	if(m_multisampleEnabled) return false;
+
+	bool isColor = (psm == PSMCT32) || (psm == PSMCT24);
+	bool isDepth = (psm == PSMZ32) || (psm == PSMZ24);
+
+	if(isColor)
+	{
+		auto framebufferIterator = std::find_if(m_framebuffers.begin(), m_framebuffers.end(),
+		                                        [&](const FramebufferPtr& framebuffer) {
+			                                        return (framebuffer->m_basePtr == bufPtr) && (framebuffer->m_width == bufWidth) &&
+			                                               ((framebuffer->m_psm == PSMCT32) || (framebuffer->m_psm == PSMCT24));
+		                                        });
+		if(framebufferIterator == std::end(m_framebuffers)) return false;
+		const auto& framebuffer = (*framebufferIterator);
+		if(((x + width) > framebuffer->m_width) || ((y + height) > framebuffer->m_height)) return false;
+
+		//What the game uploaded there since it was last drawn to
+		CommitFramebufferDirtyPages(framebuffer, y, y + height);
 
-		//Write back to RAM
+		uint32 scale = m_fbScale;
+		std::vector<uint32> scaledPixels(width * scale * height * scale);
+		m_validGlState &= ~GLSTATE_FRAMEBUFFER;
+		glBindFramebuffer(GL_FRAMEBUFFER, framebuffer->m_framebuffer);
+		glReadPixels(x * scale, y * scale, width * scale, height * scale, GL_RGBA, GL_UNSIGNED_BYTE, scaledPixels.data());
+		CHECKGLERROR();
+
+		for(uint32 py = 0; py < height; py++)
 		{
-			CGsPixelFormats::CPixelIndexorPSMCT32 indexor(m_pRAM, bltBuf.GetDstPtr(), bltBuf.nDstWidth);
-			for(uint32 y = 0; y < trxReg.nRRH; y++)
+			for(uint32 px = 0; px < width; px++)
 			{
-				for(uint32 x = 0; x < trxReg.nRRW; x++)
-				{
-					auto pixel = imgbuffer.GetPixel(x, y);
-					indexor.SetPixel(trxPos.nDSAX + x, trxPos.nDSAY + y, MakeColor(pixel.r, pixel.g, pixel.b, pixel.a));
-				}
+				uint32 pixel = scaledPixels[(px * scale) + (scale / 2) + (((py * scale) + (scale / 2)) * width * scale)];
+				//Alpha is drawn at twice its GS value (0x80 is 1.0)
+				uint32 alpha = ((pixel >> 24) + 1) >> 1;
+				pixels[px + (py * width)] = (pixel & 0x00FFFFFF) | (alpha << 24);
 			}
 		}
+		return true;
 	}
-	else
+	else if(isDepth)
 	{
-		assert(0);
+		auto depthbufferIterator = std::find_if(m_depthbuffers.begin(), m_depthbuffers.end(),
+		                                        [&](const DepthbufferPtr& depthbuffer) {
+			                                        return (depthbuffer->m_basePtr == bufPtr) && (depthbuffer->m_width == bufWidth);
+		                                        });
+		if(depthbufferIterator == std::end(m_depthbuffers)) return false;
+		const auto& depthbuffer = (*depthbufferIterator);
+		if(((x + width) > depthbuffer->m_width) || ((y + height) > depthbuffer->m_height)) return false;
+		return ReadDepthPixels(depthbuffer, x, y, width, height, pixels.data());
 	}
+	return false;
+}
