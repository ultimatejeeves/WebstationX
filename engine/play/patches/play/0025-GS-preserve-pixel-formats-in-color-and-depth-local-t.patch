+bool CGSH_OpenGL::ReadDepthPixels(const DepthbufferPtr& depthbuffer, uint32 x, uint32 y, uint32 width, uint32 height, uint32* pixels)
+{
+	uint32 scale = m_fbScale;
+	uint32 fullWidth = depthbuffer->m_width * scale;
+	uint32 fullHeight = depthbuffer->m_height * scale;
+
+	if(!m_depthReadProgram)
+	{
+		m_depthReadProgram = GenerateDepthReadProgram();
+		m_depthReadOriginUniform = glGetUniformLocation(*m_depthReadProgram, "g_origin");
+		m_depthReadScaleUniform = glGetUniformLocation(*m_depthReadProgram, "g_scale");
+		m_depthReadTextureUniform = glGetUniformLocation(*m_depthReadProgram, "g_texture");
+		m_depthReadDepthTexture = Framework::OpenGl::CTexture::Create();
+		m_depthReadColorTexture = Framework::OpenGl::CTexture::Create();
+		m_depthReadSrcFramebuffer = Framework::OpenGl::CFramebuffer::Create();
+		m_depthReadDepthFramebuffer = Framework::OpenGl::CFramebuffer::Create();
+		m_depthReadColorFramebuffer = Framework::OpenGl::CFramebuffer::Create();
+		m_depthReadTextureWidth = 0;
+		m_depthReadTextureHeight = 0;
+	}
+
+	m_validGlState = 0;
+	m_renderState.isValid = false;
+
+	glDisable(GL_BLEND);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glDepthMask(GL_TRUE);
+
+	glActiveTexture(GL_TEXTURE0);
+
+	//Depth renderbuffers can't be sampled: copy the area to a depth texture first
+	glBindTexture(GL_TEXTURE_2D, m_depthReadDepthTexture);
+	if((m_depthReadTextureWidth != fullWidth) || (m_depthReadTextureHeight != fullHeight))
+	{
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT32F, fullWidth, fullHeight, 0, GL_DEPTH_COMPONENT, GL_FLOAT, nullptr);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+		m_depthReadTextureWidth = fullWidth;
+		m_depthReadTextureHeight = fullHeight;
+	}
+	CHECKGLERROR();
+
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, m_depthReadSrcFramebuffer);
+	glFramebufferRenderbuffer(GL_READ_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, depthbuffer->m_depthBuffer);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_depthReadDepthFramebuffer);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, m_depthReadDepthTexture, 0);
+	bool complete = (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) &&
+	                (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+	if(complete)
+	{
+		glBlitFramebuffer(
+		    x * scale, y * scale, (x + width) * scale, (y + height) * scale,
+		    x * scale, y * scale, (x + width) * scale, (y + height) * scale,
+		    GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+	}
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+	CHECKGLERROR();
+	if(!complete)
+	{
+		glBindFramebuffer(GL_FRAMEBUFFER, 0);
+		return false;
+	}
+
+	//Then draw its values as bytes and read those
+	glBindTexture(GL_TEXTURE_2D, m_depthReadColorTexture);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+
+	glBindFramebuffer(GL_FRAMEBUFFER, m_depthReadColorFramebuffer);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_depthReadColorTexture, 0);
+	{
+		GLenum drawBufferId = GL_COLOR_ATTACHMENT0;
+		glDrawBuffers(1, &drawBufferId);
+	}
+	glDepthMask(GL_FALSE);
+	glViewport(0, 0, width, height);
+
+	glBindTexture(GL_TEXTURE_2D, m_depthReadDepthTexture);
+	glUseProgram(*m_depthReadProgram);
+	glUniform1i(m_depthReadTextureUniform, 0);
+	glUniform2i(m_depthReadOriginUniform, (x * scale) + (scale / 2), (y * scale) + (scale / 2));
+	glUniform1i(m_depthReadScaleUniform, scale);
+
+	glBindBuffer(GL_ARRAY_BUFFER, m_copyToFbVertexBuffer);
+	glBindVertexArray(m_copyToFbVertexArray);
+	glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+	glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	CHECKGLERROR();
+
+	glBindTexture(GL_TEXTURE_2D, 0);
+	return true;
 }
 
