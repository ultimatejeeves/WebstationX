+// Debug: the EE kernel's threads, semaphores and interrupt handlers (read while the VM runs: a snapshot, not exact).
+std::string debugDumpEeKernel()
+{
+	return g_virtualMachine->m_ee->m_os->DumpKernelState();
+}
+
+// Debug: core logging to the console. 0 off, 1 warnings (unimplemented syscalls and module functions), 2 everything.
+void debugSetLogLevel(int level)
+{
+	CLog::g_level = level;
+}
+
 // Debug: print every statement list the Jitter hands to the code generator (a hang while compiling shows its block last).
 void debugSetJitTrace(bool enabled)
 {
@@ -728,6 +741,8 @@ EMSCRIPTEN_BINDINGS(Play)
 	function("debugRequestVu1BlockDump", &debugRequestVu1BlockDump);
 	function("debugSetLocalsAsRegisters", &debugSetLocalsAsRegisters);
 	function("debugSetJitTrace", &debugSetJitTrace);
+	function("debugSetLogLevel", &debugSetLogLevel);
+	function("debugDumpEeKernel", &debugDumpEeKernel);
 	function("setStateHashFrames", &setStateHashFrames);
 	function("getStateHash", &getStateHash);
 	function("armStateHash", &armStateHash);
