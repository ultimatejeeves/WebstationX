+
+void CVuExecutor::UpdateFlagUse()
+{
+	m_flagUseDirty = false;
+	if(!m_flagAnalysis) return;
+	uint32 flagUse = 0;
+	for(uint32 address = 0; address < m_maxAddress; address += 8)
+	{
+		uint32 lowerOp = m_context.m_pMemoryMap->GetInstruction(address);
+		//Data and unused memory count too: anything that decodes as a flag read keeps the flags
+		switch(lowerOp >> 25)
+		{
+		case 0x14: //FSEQ
+		case 0x16: //FSAND
+		case 0x17: //FSOR
+			//The status register's current bits come from the MAC flags
+			flagUse |= FLAG_USE_STICKY | FLAG_USE_MAC;
+			break;
+		case 0x18: //FMEQ
+		case 0x1A: //FMAND
+		case 0x1B: //FMOR
+			flagUse |= FLAG_USE_MAC;
+			break;
+		}
+	}
+	if((flagUse & ~m_flagUse) != 0)
+	{
+		//Blocks compiled when nothing read these flags don't compute them
+		ClearActiveBlocksInRangeInternal(0, m_maxAddress, nullptr);
+	}
+	m_flagUse = flagUse;
+}
