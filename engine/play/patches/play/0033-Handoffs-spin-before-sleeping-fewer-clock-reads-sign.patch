+// Same for the VU1 block starting at (or containing) a microprogram address; compiled on the thread VU1 runs on.
+void debugRequestVu1BlockDump(uint32 address)
+{
+	g_virtualMachine->SendVmCall([address]() {
+		std::string result;
+		auto dump = [&]() {
+			auto& vu1 = g_virtualMachine->m_ee->m_VU1;
+			auto executor = static_cast<CVuExecutor*>(vu1.m_executor.get());
+			CBasicBlock* block = nullptr;
+			for(uint32 start = address; (start + 0x800) > address; start -= 8)
+			{
+				auto candidate = executor->FindBlockStartingAt(start);
+				if(candidate && !candidate->IsEmpty() && (candidate->GetEndAddress() >= address))
+				{
+					block = candidate;
+					break;
+				}
+				if(start == 0) break;
+			}
+			if(!block)
+			{
+				result = "no block";
+				return;
+			}
+			char header[64];
+			snprintf(header, sizeof(header), "block %04X-%04X ", block->GetBeginAddress(), block->GetEndAddress());
+			CVuBasicBlock copy(vu1, block->GetBeginAddress(), block->GetEndAddress(), BLOCK_CATEGORY_PS2_VU);
+			Jitter::g_statementDump = &result;
+			copy.Compile();
+			Jitter::g_statementDump = nullptr;
+			result = header + result;
+		};
+		if(g_virtualMachine->m_ee->m_vpu1Thread)
+		{
+			g_virtualMachine->m_ee->m_vpu1Thread->RunSync(dump);
+		}
+		else
+		{
+			dump();
+		}
+		std::lock_guard lock(g_eeBlockDumpMutex);
+		g_eeBlockDump = result;
+	});
+}
