diff --git a/Source/PS2VM.cpp b/Source/PS2VM.cpp
index d3bcbef4..911b071a 100644
--- a/Source/PS2VM.cpp
+++ b/Source/PS2VM.cpp
@@ -255,8 +255,10 @@ void CPS2VM::SetCatchUp(bool enabled)
 //as run without running them, which to the game is what a slower EE (or a busy vector unit) would be. It
 //misses vblanks and skips frames at full speed, with sound, timers and the IOP in real time. Bounded:
 //time spent waiting counts in full, and on top of that at most CATCHUP_MAX_RATIO cycles per cycle run.
-//Nothing is skipped while the emulation is on schedule, so a machine with headroom emulates exactly what
-//it did before; there is no schedule without the frame limiter (benchmarks, determinism checks).
+//Nothing is skipped before a frame is overdue (its deadline passed and the vblank hasn't come), and what
+//is skipped then is the end of the frame, where a game that finished its work waits for the vblank: a
+//machine with headroom emulates exactly what it did before. There is no deadline without the frame
+//limiter (benchmarks, determinism checks).
 int CPS2VM::TakeCatchUpTicks(int executed)
 {
 	uint64 waitUs = WsxFrameStats::g_vpu1WaitUs.load(std::memory_order_relaxed) + WsxFrameStats::g_eeGsWaitUs.load(std::memory_order_relaxed);
@@ -273,11 +275,11 @@ int CPS2VM::TakeCatchUpTicks(int executed)
 	m_catchUpCredit += static_cast<int64>((std::min<uint64>(waitedUs, 50000) * eeFreqScaled) / 1000000);
 	m_catchUpCredit = std::min(m_catchUpCredit, frameTicks);
 	//The clock is read every few slices (a slice is ~16 microseconds of emulated time)
-	if((waitedUs == 0) && ((++m_catchUpSlice & 3) != 0)) return 0;
+	if((++m_catchUpSlice & 7) != 0) return 0;
 
 	int64 remaining = m_inVblank ? (static_cast<int64>(m_vblankTicks) + m_onScreenTicksTotal) : static_cast<int64>(m_vblankTicks);
 	double fraction = 1.0 - (static_cast<double>(remaining) / static_cast<double>(frameTicks));
-	double lateUs = m_frameLimiter.GetLatenessUs(fraction);
+	double lateUs = m_frameLimiter.GetLatenessUs(1.0);
 	if(lateUs > 100000.0)
 	{
 		//Not something to play back (the tab was suspended, a long compile or disc stall)
@@ -285,9 +287,10 @@ int CPS2VM::TakeCatchUpTicks(int executed)
 		m_catchUpCredit = 0;
 		return 0;
 	}
-	if(lateUs < 250.0) return 0;
-	int64 lateTicks = static_cast<int64>(lateUs * static_cast<double>(eeFreqScaled) / 1000000.0);
-	int64 skipped = std::min(lateTicks, m_catchUpCredit);
+	//(remaining isn't positive when the vblank is due: the main loop takes it once this slice returns)
+	if((lateUs <= 0) || (remaining <= 0)) return 0;
+	//Overdue: get to the vblank as fast as the bound allows
+	int64 skipped = std::max<int64>(std::min(remaining, m_catchUpCredit), 0);
 	m_catchUpCredit -= skipped;
 	return static_cast<int>(skipped);
