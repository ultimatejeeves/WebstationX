From 6d496c8ddeb4f3340c0f722f65862ba753048604 Mon Sep 17 00:00:00 2001
From: ultimatejeeves <ultimatejeeves@users.noreply.github.com>
Date: Wed, 30 Sep 2026 23:07:10 -0400
Subject: [PATCH 28/43] Web: discard frame debt after hitches and late wakeups

---
 Source/FrameLimiter.cpp    | 6 ++++--
 Source/iop/Iop_Cdvdman.cpp | 3 ++-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/Source/FrameLimiter.cpp b/Source/FrameLimiter.cpp
index 075e3de1..20737a9b 100644
--- a/Source/FrameLimiter.cpp
+++ b/Source/FrameLimiter.cpp
@@ -51,8 +51,6 @@ void CFrameLimiter::EndFrame()
 		else
 		{
 			m_nextDeadline += m_minFrameDuration;
-			//Discard a large debt without sleeping an extra frame on an already slow machine.
-			if((now - m_nextDeadline) > (m_minFrameDuration * 4)) m_nextDeadline = now;
 		}
 		WsxFrameStats::CScope sleepScope(WsxFrameStats::g_vmSleepUs);
 		//A sleep can wake up a whole OS timer tick late: 15.6 ms on Windows, where the browser usually
@@ -82,6 +80,10 @@ void CFrameLimiter::EndFrame()
 			}
 			now = std::chrono::high_resolution_clock::now();
 		}
+		//A real hitch (work, compilation or an oversleep) must not become several
+		//unthrottled catch-up frames. Rebase after the late frame, including late
+		//wakeups inside the loop. Keep sub-ms timer noise on the running cadence.
+		if((now - m_nextDeadline) > std::chrono::milliseconds(1)) m_nextDeadline = now;
 		//Decay slowly (halves in ~45 s): a machine whose timer got finer goes back to sleeping.
 		m_sleepSlack -= m_sleepSlack / 4096;
 	}
diff --git a/Source/iop/Iop_Cdvdman.cpp b/Source/iop/Iop_Cdvdman.cpp
index 767cdfd0..1b7282a0 100644
--- a/Source/iop/Iop_Cdvdman.cpp
+++ b/Source/iop/Iop_Cdvdman.cpp
@@ -534,7 +534,8 @@ uint32 CCdvdman::CdSync(uint32 mode)
 			//Put the thread in a wait state till the CD command is complete
 			m_bios.WaitCdSync();
 		}
-		//When the thread will be ready, the return value needs to be 0
+		//WaitCdSync re-enters this call after waking: another waiter may have
+		//started a command meanwhile. Only the final, idle check returns to the caller.
 		return 0;
 	}
 	return (m_pendingCommand == COMMAND_NONE) ? 0 : 1;
-- 
