+std::string disassembleEe(uint32 address, int count)
+{
+	std::string result;
+	auto& ee = g_virtualMachine->m_ee->m_EE;
+	for(int i = 0; i < count; i++)
+	{
+		uint32 pc = address + i * 4;
+		uint32 opcode = ee.m_pMemoryMap->GetInstruction(pc);
+		char mnemonic[256] = {}, operands[256] = {};
+		ee.m_pArch->GetInstructionMnemonic(&ee, pc, opcode, mnemonic, sizeof(mnemonic));
+		ee.m_pArch->GetInstructionOperands(&ee, pc, opcode, operands, sizeof(operands));
+		char line[600];
+		snprintf(line, sizeof(line), "%08X  %08X  %-8s %s\n", pc, opcode, mnemonic, operands);
+		result += line;
+	}
+	return result;
+}
+
+// Master volume, 0..1 (OpenAL listener gain; runs on the main thread that owns the AL context).
+void setVolume(float gain)
+{
+	alListenerf(AL_GAIN, gain);
+}
