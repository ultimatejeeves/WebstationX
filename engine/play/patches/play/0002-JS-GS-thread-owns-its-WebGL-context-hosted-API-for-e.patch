diff --git a/Source/ui_js/PH_Js.cpp b/Source/ui_js/PH_Js.cpp
new file mode 100644
index 00000000..98420613
--- /dev/null
+++ b/Source/ui_js/PH_Js.cpp
@@ -0,0 +1,54 @@
+#include "PH_Js.h"
+#include <algorithm>
+
+using namespace PS2;
+
+std::atomic<uint32> CPH_Js::m_buttons[MAX_PADS] = {};
+std::atomic<uint32> CPH_Js::m_axes[MAX_PADS] = {{0x80808080}, {0x80808080}};
+std::atomic<uint32> CPH_Js::m_vibration[MAX_PADS] = {};
+
+void CPH_Js::SetPadState(unsigned int pad, uint32 buttons, uint32 axes)
+{
+	if(pad >= MAX_PADS) return;
+	m_buttons[pad].store(buttons, std::memory_order_relaxed);
+	m_axes[pad].store(axes, std::memory_order_relaxed);
+}
+
+uint32 CPH_Js::GetVibration(unsigned int pad)
+{
+	return (pad < MAX_PADS) ? m_vibration[pad].load(std::memory_order_relaxed) : 0;
+}
+
+void CPH_Js::Update(uint8* ram)
+{
+	uint32 large[MAX_PADS] = {}, small[MAX_PADS] = {};
+	for(auto* padInterface : m_interfaces)
+	{
+		for(unsigned int pad = 0; pad < MAX_PADS; pad++)
+		{
+			uint32 buttons = m_buttons[pad].load(std::memory_order_relaxed);
+			uint32 axes = m_axes[pad].load(std::memory_order_relaxed);
+			padInterface->SetAxisState(pad, CControllerInfo::ANALOG_LEFT_X, (axes >> 0) & 0xFF, ram);
+			padInterface->SetAxisState(pad, CControllerInfo::ANALOG_LEFT_Y, (axes >> 8) & 0xFF, ram);
+			padInterface->SetAxisState(pad, CControllerInfo::ANALOG_RIGHT_X, (axes >> 16) & 0xFF, ram);
+			padInterface->SetAxisState(pad, CControllerInfo::ANALOG_RIGHT_Y, (axes >> 24) & 0xFF, ram);
+			for(unsigned int b = CControllerInfo::DPAD_UP; b < CControllerInfo::MAX_BUTTONS; b++)
+			{
+				padInterface->SetButtonState(pad, static_cast<CControllerInfo::BUTTON>(b), (buttons >> b) & 1, ram);
+			}
+			uint8 l = 0, s = 0;
+			padInterface->GetVibration(pad, l, s);
+			large[pad] = std::max<uint32>(large[pad], l);
+			small[pad] = std::max<uint32>(small[pad], s);
+		}
+	}
+	for(unsigned int pad = 0; pad < MAX_PADS; pad++)
+	{
+		m_vibration[pad].store(large[pad] | (small[pad] << 8), std::memory_order_relaxed);
+	}
+}
+
+CPadHandler::FactoryFunction CPH_Js::GetFactoryFunction()
+{
+	return []() { return new CPH_Js(); };
+}
