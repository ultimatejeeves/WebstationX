+// Never blocks the calling (main) thread: the VM thread may be waiting on the main thread (disc reads).
+void pauseVm()
+{
+	g_virtualMachine->PauseAsync();
+}
+
+void resumeVm()
+{
+	g_virtualMachine->ResumeAsync();
+}
+
+int getVmStatus()
+{
+	return g_virtualMachine ? static_cast<int>(g_virtualMachine->GetStatus()) : -1;
+}
+
+void setPadState(int pad, uint32 buttons, uint32 axes)
+{
+	CPH_Js::SetPadState(pad, buttons, axes);
+}
+
+uint32 getVibration(int pad)
+{
+	return CPH_Js::GetVibration(pad);
+}
+
+// Save/load state run on the VM thread; poll pollStateOp(): -2 idle, -1 pending, 0 failed, 1 done.
+void saveState(std::string path)
+{
+	g_stateOp = g_virtualMachine->SaveState(path);
+}
+
+void loadState(std::string path)
+{
+	g_stateOp = g_virtualMachine->LoadState(path);
+}
+
+int pollStateOp()
+{
+	if(!g_stateOp.valid()) return -2;
+	if(g_stateOp.wait_for(std::chrono::seconds(0)) != std::future_status::ready) return -1;
+	return g_stateOp.get() ? 1 : 0;
+}
