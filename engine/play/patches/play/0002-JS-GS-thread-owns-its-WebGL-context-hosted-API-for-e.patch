+// clang-format off
+EM_JS(int, wsx_gs_create_context, (int width, int height), {
+	const canvas = new OffscreenCanvas(Math.max(1, width), Math.max(1, height));
+	globalThis.__wsxGsCanvas = canvas;
+	const attrs = {
+		majorVersion: 2, minorVersion: 0, alpha: false, depth: true, stencil: false, antialias: false,
+		premultipliedAlpha: true, preserveDrawingBuffer: false, powerPreference: 'high-performance',
+		failIfMajorPerformanceCaveat: false, enableExtensionsByDefault: true,
+	};
+	// Registered from this (GS) thread, so Emscripten records it as the owning thread and never proxies.
+	return GL.createContext(canvas, attrs);
+});
+
+EM_JS(void, wsx_gs_resize, (int width, int height), {
+	const canvas = globalThis.__wsxGsCanvas;
+	if (!canvas) return;
+	width = Math.max(1, width);
+	height = Math.max(1, height);
+	if (canvas.width !== width) canvas.width = width;
+	if (canvas.height !== height) canvas.height = height;
+});
+
+EM_JS(void, wsx_gs_present, (), {
+	const canvas = globalThis.__wsxGsCanvas;
+	if (!canvas) return;
+	const bitmap = canvas.transferToImageBitmap();
+	// cmd 9 = Emscripten's "callHandler" worker message: the main thread runs Module[handler](...args).
+	// The WebStationX core build script checks the generated glue still handles it this way.
+	postMessage({ cmd: 9, handler: 'wsxPresent', args: [bitmap] }, [bitmap]);
+});
+// clang-format on
 
-CGSH_OpenGL::FactoryFunction CGSH_OpenGLJs::GetFactoryFunction(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context)
