+	return []() { return new CGSH_OpenGLJs(); };
 }
 
 void CGSH_OpenGLJs::InitializeImpl()
 {
+	m_context = wsx_gs_create_context(m_presentationParams.windowWidth, m_presentationParams.windowHeight);
+	assert(m_context > 0);
 	emscripten_webgl_make_context_current(m_context);
 	CGSH_OpenGL::InitializeImpl();
 }
@@ -19,8 +49,21 @@ void CGSH_OpenGLJs::InitializeImpl()
 void CGSH_OpenGLJs::ReleaseImpl()
 {
 	CGSH_OpenGL::ReleaseImpl();
+	if(m_context)
+	{
+		emscripten_webgl_make_context_current(0);
+		emscripten_webgl_destroy_context(m_context);
+		m_context = 0;
+	}
+}
+
+void CGSH_OpenGLJs::SetPresentationParams(const PRESENTATION_PARAMS& presentationParams)
+{
+	CGSH_OpenGL::SetPresentationParams(presentationParams);
+	SendGSCall([width = presentationParams.windowWidth, height = presentationParams.windowHeight]() { wsx_gs_resize(width, height); });
 }
 
