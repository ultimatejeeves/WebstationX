@@ -0,0 +1,30 @@
+#pragma once
+
+#include <atomic>
+#include "PadHandler.h"
+#include "ControllerInfo.h"
+
+// Pad handler fed directly from JavaScript (WebStationX): the page samples its gamepads / keyboard
+// and writes a packed state per pad; the VM thread reads it on every pad poll. No binding layer.
+class CPH_Js : public CPadHandler
+{
+public:
+	enum
+	{
+		MAX_PADS = 2, // Play! emulates the two controller ports (no multitap)
+	};
+
+	// Bit i of `buttons` = PS2::CControllerInfo::BUTTON (DPAD_UP .. R3); axes packed as lx | ly << 8 | rx << 16 | ry << 24.
+	static void SetPadState(unsigned int pad, uint32 buttons, uint32 axes);
+	// Vibration of `pad` as large | small << 8, last reported by the game.
+	static uint32 GetVibration(unsigned int pad);
+
+	void Update(uint8*) override;
+
+	static FactoryFunction GetFactoryFunction();
+
+private:
+	static std::atomic<uint32> m_buttons[MAX_PADS];
+	static std::atomic<uint32> m_axes[MAX_PADS];
+	static std::atomic<uint32> m_vibration[MAX_PADS];
+};
