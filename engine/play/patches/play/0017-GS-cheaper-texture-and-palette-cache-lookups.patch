From 2bd49133f9d05a606e97ec8081894f2de909eac1 Mon Sep 17 00:00:00 2001
From: ultimatejeeves <ultimatejeeves@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:19:04 -0400
Subject: [PATCH 17/43] GS: cheaper texture and palette cache lookups

Every upload invalidates against all 256 cached textures and every framebuffer, and each check
recomputed the area's page rect through GetPsmPageSize: the page count is now kept by SetArea.
Texture and palette searches copied each list entry's shared_ptr (atomic refcounts) while scanning.
GS busy per frame 7.3 -> 6.4 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp | 21 ++++++++++++---------
 Source/gs/GsCachedArea.cpp                  | 11 +++++------
 Source/gs/GsCachedArea.h                    |  1 +
 Source/gs/GsTextureCache.h                  |  7 ++++---
 4 files changed, 22 insertions(+), 18 deletions(-)

diff --git a/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp b/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
index 01a12176..b315073f 100644
--- a/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
+++ b/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
@@ -719,14 +719,16 @@ void CGSH_OpenGL::CPalette::Invalidate(uint32 csa)
 
 GLuint CGSH_OpenGL::PalCache_Search(const TEX0& tex0)
 {
+	bool isIDTEX4 = CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm);
 	for(auto paletteIterator(m_paletteCache.begin());
 	    paletteIterator != m_paletteCache.end(); paletteIterator++)
 	{
-		auto palette = *paletteIterator;
-		if(!palette->m_live) continue;
-		if(CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm) != palette->m_isIDTEX4) continue;
-		if(tex0.nCPSM != palette->m_cpsm) continue;
-		if(tex0.nCSA != palette->m_csa) continue;
+		const auto& candidate = *paletteIterator;
+		if(!candidate->m_live) continue;
+		if(isIDTEX4 != candidate->m_isIDTEX4) continue;
+		if(tex0.nCPSM != candidate->m_cpsm) continue;
+		if(tex0.nCSA != candidate->m_csa) continue;
+		auto palette = candidate;
 		m_paletteCache.erase(paletteIterator);
 		m_paletteCache.push_front(palette);
 		return palette->m_texture;
@@ -740,15 +742,16 @@ GLuint CGSH_OpenGL::PalCache_Search(unsigned int entryCount, const uint32* conte
 	for(auto paletteIterator(m_paletteCache.begin());
 	    paletteIterator != m_paletteCache.end(); paletteIterator++)
 	{
-		auto palette = *paletteIterator;
+		const auto& candidate = *paletteIterator;
 
-		if(palette->m_texture == 0) continue;
+		if(candidate->m_texture == 0) continue;
 
-		unsigned int palEntryCount = palette->m_isIDTEX4 ? 16 : 256;
+		unsigned int palEntryCount = candidate->m_isIDTEX4 ? 16 : 256;
 		if(palEntryCount != entryCount) continue;
 
-		if(memcmp(contents, palette->m_contents, sizeof(uint32) * entryCount) != 0) continue;
+		if(memcmp(contents, candidate->m_contents, sizeof(uint32) * entryCount) != 0) continue;
 
+		auto palette = candidate;
 		palette->m_live = true;
 
 		m_paletteCache.erase(paletteIterator);
diff --git a/Source/gs/GsCachedArea.cpp b/Source/gs/GsCachedArea.cpp
index 7a805ae5..e682d5ca 100644
--- a/Source/gs/GsCachedArea.cpp
+++ b/Source/gs/GsCachedArea.cpp
@@ -30,11 +30,11 @@ void CGsCachedArea::SetArea(uint32 psm, uint32 bufPtr, uint32 bufWidth, uint32 h
 	m_bufWidth = bufWidth;
 	m_height = height;
 
+	auto pageRect = GetAreaPageRect();
+	m_pageCount = pageRect.width * pageRect.height;
+
 	//Check that we have enough bits to represent page dirtyness in m_dirtyPages
-	{
-		FRAMEWORK_MAYBE_UNUSED auto pageRect = GetAreaPageRect();
-		assert((pageRect.width * pageRect.height) <= MAX_DIRTYPAGES);
-	}
+	assert(m_pageCount <= MAX_DIRTYPAGES);
 }
 
 CGsCachedArea::PageRect CGsCachedArea::GetAreaPageRect() const
@@ -98,8 +98,7 @@ CGsCachedArea::PageRect CGsCachedArea::GetDirtyPageRect() const
 
 uint32 CGsCachedArea::GetPageCount() const
 {
-	auto areaRect = GetAreaPageRect();
-	return areaRect.width * areaRect.height;
+	return m_pageCount;
 }
 
 uint32 CGsCachedArea::GetSize() const
diff --git a/Source/gs/GsCachedArea.h b/Source/gs/GsCachedArea.h
index 710b76b4..bf8b5118 100644
--- a/Source/gs/GsCachedArea.h
+++ b/Source/gs/GsCachedArea.h
@@ -44,6 +44,7 @@ private:
 	uint32 m_bufPtr = 0;
 	uint32 m_bufWidth = 0;
 	uint32 m_height = 0;
+	uint32 m_pageCount = 0; //GetAreaPageRect's page count, kept by SetArea (Invalidate runs per upload per cached area)
 
 	DirtyPageHolder m_dirtyPages[MAX_DIRTYPAGES_SECTIONS];
 };
diff --git a/Source/gs/GsTextureCache.h b/Source/gs/GsTextureCache.h
index 67b0882e..e1edf09a 100644
--- a/Source/gs/GsTextureCache.h
+++ b/Source/gs/GsTextureCache.h
@@ -48,9 +48,10 @@ public:
 		for(auto textureIterator(m_textureCache.begin());
 		    textureIterator != m_textureCache.end(); textureIterator++)
 		{
-			auto texture = *textureIterator;
-			if(!texture->m_live) continue;
-			if(maskedTex0 != texture->m_tex0) continue;
+			const auto& candidate = *textureIterator;
+			if(!candidate->m_live) continue;
+			if(maskedTex0 != candidate->m_tex0) continue;
+			auto texture = candidate;
 			m_textureCache.erase(textureIterator);
 			m_textureCache.push_front(texture);
 			return texture.get();
-- 
