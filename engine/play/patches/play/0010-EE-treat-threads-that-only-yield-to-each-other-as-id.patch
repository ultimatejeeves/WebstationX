 	if(func == SYSCALL_CUSTOM_RESCHEDULE)
 	{
diff --git a/Source/ee/PS2OS.h b/Source/ee/PS2OS.h
index 8dab3424..0b5d2fde 100644
--- a/Source/ee/PS2OS.h
+++ b/Source/ee/PS2OS.h
@@ -33,6 +33,11 @@ public:
 	void Release();
 
 	bool IsIdle() const;
