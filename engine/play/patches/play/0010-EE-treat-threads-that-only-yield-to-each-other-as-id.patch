--- a/Source/ee/PS2OS.cpp
+++ b/Source/ee/PS2OS.cpp
@@ -2224,6 +2224,8 @@ void CPS2OS::sc_RotateThreadReadyQueue()
 	ThreadShakeAndBake();
 
 	m_idleEvaluator.NotifyEvent(Ee::CIdleEvaluator::EVENT_ROTATETHREADREADYQUEUE, threadIdBefore, m_currentThreadId);
+	m_idleEvaluator.NotifyRotate(m_executedCycles - m_lastRotateCycles);
