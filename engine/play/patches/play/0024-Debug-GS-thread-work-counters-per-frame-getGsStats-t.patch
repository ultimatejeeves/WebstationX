From b8f88c5aa87be4985fae8519de7d352a04f4357b Mon Sep 17 00:00:00 2001
From: ultimatejeeves <ultimatejeeves@users.noreply.github.com>
Date: Wed, 30 Sep 2026 16:02:32 -0400
Subject: [PATCH 24/43] Debug: GS thread work counters per frame (getGsStats):
 transfers and how many changed memory, texture and palette uploads, CLUT
 reads, draws, vertices, texture rebinds, register writes, mailbox calls

---
 Source/gs/GSH_OpenGL/GSH_OpenGL.cpp         |  8 ++++++
 Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp |  5 ++++
 Source/gs/GSHandler.cpp                     |  9 +++++++
 Source/gs/WsxGsStats.h                      | 26 ++++++++++++++++++++
 Source/ui_js/Main.cpp                       | 27 +++++++++++++++++++++
 5 files changed, 75 insertions(+)
 create mode 100644 Source/gs/WsxGsStats.h

diff --git a/Source/gs/GSH_OpenGL/GSH_OpenGL.cpp b/Source/gs/GSH_OpenGL/GSH_OpenGL.cpp
index 5f05a2f7..7ea3ba9f 100644
--- a/Source/gs/GSH_OpenGL/GSH_OpenGL.cpp
+++ b/Source/gs/GSH_OpenGL/GSH_OpenGL.cpp
@@ -7,6 +7,7 @@
 #include "../GsPixelFormats.h"
 #include "../GsTransferRange.h"
 #include "GSH_OpenGL.h"
+#include "../WsxGsStats.h"
 #include <atomic>
 
 // Debug: frames left to trace GS draws/transfers for (set from the page with gsTrace()).
@@ -1758,6 +1759,8 @@ void CGSH_OpenGL::FlushVertexBuffer()
 
 void CGSH_OpenGL::DoRenderPass()
 {
+	g_wsxGsStats.draws.fetch_add(1, std::memory_order_relaxed);
+	g_wsxGsStats.verts.fetch_add(m_vertexBuffer.size(), std::memory_order_relaxed);
 	if((m_validGlState & GLSTATE_VERTEX_PARAMS) == 0)
 	{
 		glBindBuffer(GL_UNIFORM_BUFFER, m_vertexParamsBuffer);
@@ -1776,6 +1779,7 @@ void CGSH_OpenGL::DoRenderPass()
 
 	if((m_validGlState & GLSTATE_PROGRAM) == 0)
 	{
+		g_wsxGsStats.shaderSwitches.fetch_add(1, std::memory_order_relaxed);
 		glUseProgram(m_renderState.shaderHandle);
 		m_validGlState |= GLSTATE_PROGRAM;
 	}
@@ -1822,6 +1826,7 @@ void CGSH_OpenGL::DoRenderPass()
 
 	if((m_validGlState & GLSTATE_TEXTURE) == 0)
 	{
+		g_wsxGsStats.texSetups.fetch_add(1, std::memory_order_relaxed);
 		glActiveTexture(GL_TEXTURE0);
 		glBindTexture(GL_TEXTURE_2D, m_renderState.texture0Handle);
 		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, m_renderState.texture0MinFilter);
@@ -1842,6 +1847,7 @@ void CGSH_OpenGL::DoRenderPass()
 
 	if((m_validGlState & GLSTATE_FRAMEBUFFER) == 0)
 	{
+		g_wsxGsStats.fbSetups.fetch_add(1, std::memory_order_relaxed);
 		glBindFramebuffer(GL_FRAMEBUFFER, m_renderState.framebufferHandle);
 		m_validGlState |= GLSTATE_FRAMEBUFFER;
 	}
@@ -2144,8 +2150,10 @@ void CGSH_OpenGL::ProcessHostToLocalTransfer()
 		printf("GST h2l bitblt=%llx trxpos=%llx trxreg=%llx dirty=%d\n", (unsigned long long)m_nReg[GS_REG_BITBLTBUF], (unsigned long long)m_nReg[GS_REG_TRXPOS],
 		       (unsigned long long)m_nReg[GS_REG_TRXREG], (int)m_trxCtx.nDirty);
 	}
+	g_wsxGsStats.transfers.fetch_add(1, std::memory_order_relaxed);
 	if(m_trxCtx.nDirty)
 	{
+		g_wsxGsStats.transfersDirty.fetch_add(1, std::memory_order_relaxed);
 		FlushVertexBuffer();
 		m_renderState.isTextureStateValid = false;
 		m_renderState.isFramebufferStateValid = false;
diff --git a/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp b/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
index b315073f..f0df20b5 100644
--- a/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
+++ b/Source/gs/GSH_OpenGL/GSH_OpenGL_Texture.cpp
@@ -8,6 +8,7 @@
 #endif
 #include "SimdDefs.h"
 #include "GSH_OpenGL.h"
+#include "../WsxGsStats.h"
 #include "StdStream.h"
 #include "bitmap/BMP.h"
 #include "../GsPixelFormats.h"
@@ -204,6 +205,7 @@ CGSH_OpenGL::TEXTURE_INFO CGSH_OpenGL::PrepareTexture(const TEX0& tex0)
 		auto texFormat = GetTextureFormatInfo(tex0.nPsm);
 
 		{
+			g_wsxGsStats.texMisses.fetch_add(1, std::memory_order_relaxed);
 			auto textureHandle = Framework::OpenGl::CTexture::Create();
 			glBindTexture(GL_TEXTURE_2D, textureHandle);
 			glTexStorage2D(GL_TEXTURE_2D, 1, texFormat.internalFormat, texWidth, texHeight);
@@ -244,6 +246,8 @@ CGSH_OpenGL::TEXTURE_INFO CGSH_OpenGL::PrepareTexture(const TEX0& tex0)
 		{
 			texHeight = tex0.GetHeight() - texY;
 		}
+		g_wsxGsStats.texUploads.fetch_add(1, std::memory_order_relaxed);
+		g_wsxGsStats.texUploadPx.fetch_add(texWidth * texHeight, std::memory_order_relaxed);
 		((this)->*(m_textureUpdater[tex0.nPsm]))(tex0.GetBufPtr(), tex0.nBufWidth, texX, texY, texWidth, texHeight);
 	}
 
@@ -270,6 +274,7 @@ GLuint CGSH_OpenGL::PreparePalette(const TEX0& tex0)
 		return textureHandle;
 	}
 
+	g_wsxGsStats.palMisses.fetch_add(1, std::memory_order_relaxed);
 	glGenTextures(1, &textureHandle);
 	glBindTexture(GL_TEXTURE_2D, textureHandle);
 	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, entryCount, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, convertedClut.data());
diff --git a/Source/gs/GSHandler.cpp b/Source/gs/GSHandler.cpp
index 40eab8d5..d7bbf870 100644
--- a/Source/gs/GSHandler.cpp
+++ b/Source/gs/GSHandler.cpp
@@ -35,6 +35,9 @@ EM_JS(void, wsx_gs_yield, (uintptr_t fn, void* arg), {
 #include "../FrameDump.h"
 #include "../ee/INTC.h"
 #include "GSHandler.h"
