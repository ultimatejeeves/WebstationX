+
+WSX_GS_STATS g_wsxGsStats;
 #include "GsTransferFast.h"
 #include "GsPixelFormats.h"
 #include "string_format.h"
@@ -633,6 +636,7 @@ void CGSHandler::Flip(uint32 flags)
 
 void CGSHandler::FlipImpl(const DISPLAY_INFO&)
 {
+	g_wsxGsStats.frames.fetch_add(1, std::memory_order_relaxed);
 	OnFlipComplete();
 	m_flipped = true;
 }
@@ -809,6 +813,7 @@ void CGSHandler::FlushWriteBuffer()
 
 void CGSHandler::WriteRegisterImpl(uint8 nRegister, uint64 nData)
 {
+	g_wsxGsStats.regWrites.fetch_add(1, std::memory_order_relaxed);
 	nRegister &= REGISTER_MAX - 1;
 	m_nReg[nRegister] = nData;
 	m_regsDirty = true;
@@ -896,6 +901,7 @@ void CGSHandler::FeedImageDataImpl(const uint8* imageData, uint32 length)
 			length = m_trxCtx.nSize;
 		}
 
+		g_wsxGsStats.transferBytes.fetch_add(length, std::memory_order_relaxed);
 		TransferWrite(imageData, length);
 		m_trxCtx.nSize -= length;
 
@@ -1485,6 +1491,7 @@ CGSHandler::DISPLAY_INFO CGSHandler::GetCurrentDisplayInfo()
 void CGSHandler::SyncCLUT(const TEX0& tex0)
 {
 	if(!ProcessCLD(tex0)) return;
+	g_wsxGsStats.clutReads.fetch_add(1, std::memory_order_relaxed);
 
 	//assert(IsPsmIDTEX(tex0.nPsm));
 	switch(tex0.nPsm)
@@ -2224,6 +2231,7 @@ void CGSHandler::ThreadSlice(void* param)
 
 void CGSHandler::SendGSCall(const CMailBox::FunctionType& function, bool waitForCompletion, bool forceWaitForCompletion)
 {
+	g_wsxGsStats.gsCalls.fetch_add(1, std::memory_order_relaxed);
 	if(!m_gsThreaded)
 	{
 		waitForCompletion = false;
@@ -2241,6 +2249,7 @@ void CGSHandler::SendGSCall(const CMailBox::FunctionType& function, bool waitFor
 
 void CGSHandler::SendGSCall(CMailBox::FunctionType&& function)
 {
+	g_wsxGsStats.gsCalls.fetch_add(1, std::memory_order_relaxed);
 	m_mailBox.SendCall(std::move(function));
 }
 
diff --git a/Source/gs/WsxGsStats.h b/Source/gs/WsxGsStats.h
new file mode 100644
index 00000000..c8aa9407
--- /dev/null
+++ b/Source/gs/WsxGsStats.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <atomic>
+#include "Types.h"
+
+//Debug counters for the GS thread: what a frame costs in transfers, texture and palette uploads, draws
+//and register writes (the bench prints them per frame). Relaxed atomics: written by the GS thread, read by the page.
+struct WSX_GS_STATS
+{
+	std::atomic<uint64> frames = 0;         //Flips
+	std::atomic<uint64> regWrites = 0;      //WriteRegisterImpl calls
+	std::atomic<uint64> gsCalls = 0;        //SendGSCall (mailbox) calls
+	std::atomic<uint64> transfers = 0;      //host->local transfers completed
+	std::atomic<uint64> transfersDirty = 0; //...that changed GS memory
+	std::atomic<uint64> transferBytes = 0;  //image data fed
+	std::atomic<uint64> texMisses = 0;      //GL textures created (cache miss)
+	std::atomic<uint64> texUploads = 0;     //texture updater calls (glTexSubImage2D)
+	std::atomic<uint64> texUploadPx = 0;    //pixels they uploaded
+	std::atomic<uint64> palMisses = 0;      //palette textures created
+	std::atomic<uint64> clutReads = 0;      //CLUT loads into the local CLUT
+	std::atomic<uint64> draws = 0;          //render passes (glDrawArrays + glBufferData)
+	std::atomic<uint64> verts = 0;          //vertices in them
+	std::atomic<uint64> texSetups = 0;      //texture state rebinds (glTexParameteri x9)
+	std::atomic<uint64> fbSetups = 0;       //framebuffer rebinds
+	std::atomic<uint64> shaderSwitches = 0; //glUseProgram
+};
+extern WSX_GS_STATS g_wsxGsStats;
diff --git a/Source/ui_js/Main.cpp b/Source/ui_js/Main.cpp
index 72e05240..3ad9326b 100644
--- a/Source/ui_js/Main.cpp
+++ b/Source/ui_js/Main.cpp
@@ -502,6 +502,32 @@ void setVpu1ThreadMode(int mode)
 	CVpu1Thread::g_mode = static_cast<uint32>(mode);
 }
 
+#include "../gs/WsxGsStats.h"
+// Debug: GS thread work counters since boot (see WsxGsStats.h); the bench divides them by frames.
+std::string getGsStats()
+{
+	auto& s = g_wsxGsStats;
+	char text[1024];
+	snprintf(text, sizeof(text), "{\"frames\":%llu,\"regWrites\":%llu,\"gsCalls\":%llu,\"transfers\":%llu,\"transfersDirty\":%llu,\"transferBytes\":%llu,\"texMisses\":%llu,\"texUploads\":%llu,\"texUploadPx\":%llu,\"palMisses\":%llu,\"clutReads\":%llu,\"draws\":%llu,\"verts\":%llu,\"texSetups\":%llu,\"fbSetups\":%llu,\"shaderSwitches\":%llu}",
+	         (unsigned long long)s.frames.load(),
+	         (unsigned long long)s.regWrites.load(),
+	         (unsigned long long)s.gsCalls.load(),
+	         (unsigned long long)s.transfers.load(),
+	         (unsigned long long)s.transfersDirty.load(),
+	         (unsigned long long)s.transferBytes.load(),
+	         (unsigned long long)s.texMisses.load(),
+	         (unsigned long long)s.texUploads.load(),
+	         (unsigned long long)s.texUploadPx.load(),
+	         (unsigned long long)s.palMisses.load(),
+	         (unsigned long long)s.clutReads.load(),
+	         (unsigned long long)s.draws.load(),
+	         (unsigned long long)s.verts.load(),
+	         (unsigned long long)s.texSetups.load(),
+	         (unsigned long long)s.fbSetups.load(),
+	         (unsigned long long)s.shaderSwitches.load());
+	return text;
+}
+
 std::string getVpu1Stats()
 {
 	auto& stats = CVpu1Thread::g_stats;
@@ -546,6 +572,7 @@ EMSCRIPTEN_BINDINGS(Play)
 	function("getVpu1ZoneAddress", &getVpu1ZoneAddress);
 	function("setVpu1ThreadMode", &setVpu1ThreadMode);
 	function("getVpu1Stats", &getVpu1Stats);
+	function("getGsStats", &getGsStats);
 	function("debugRequestEeBlockDump", &debugRequestEeBlockDump);
 	function("debugTakeEeBlockDump", &debugTakeEeBlockDump);
 	function("debugSetLocalsAsRegisters", &debugSetLocalsAsRegisters);
