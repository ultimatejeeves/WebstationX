@@ -65,5 +82,36 @@ void CGSH_OpenGLJs::SetPresentationParams(const PRESENTATION_PARAMS& presentatio
 
 void CGSH_OpenGLJs::PresentBackbuffer()
 {
-	wsx_gs_present();
+	WsxFrameStats::MarkGsFrame();
+	if(wsx_gs_present())
+	{
+		RecoverLostContext();
+	}
+}
+
+//The browser can take the WebGL context away (GPU reset, video memory exhausted): the picture goes black
+//for good while the game keeps running. The GL side holds nothing that can't be rebuilt (GS memory lives
+//in m_pRAM), so rebuild it on a new canvas. The GS thread never returns to its event loop, so the
+//context's lost/restored events never arrive: this runs from the per-frame check instead.
+void CGSH_OpenGLJs::RecoverLostContext()
+{
+	double now = WsxFrameStats::Now();
+	if((now - m_lastRecoveryAttempt) < 2000.0) return;
+	bool firstAttempt = (m_lastRecoveryAttempt == 0) || ((now - m_lastRecoveryAttempt) > 10000.0);
+	m_lastRecoveryAttempt = now;
+	if(firstAttempt) wsx_gs_event("lost");
+
+	//New context first: if the GPU isn't back yet, keep the lost one current (its calls are no-ops).
+	auto newContext = wsx_gs_create_context(m_presentationParams.windowWidth, m_presentationParams.windowHeight);
+	if(newContext <= 0)
+	{
+		wsx_gs_event("restore-failed");
+		return;
+	}
+	CGSH_OpenGL::ReleaseImpl();
+	emscripten_webgl_make_context_current(newContext);
+	wsx_gs_destroy_context(m_context);
+	m_context = newContext;
+	CGSH_OpenGL::InitializeImpl();
+	wsx_gs_event("restored");
 }
