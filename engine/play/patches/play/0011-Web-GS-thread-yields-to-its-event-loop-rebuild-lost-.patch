diff --git a/Source/WsxFrameStats.h b/Source/WsxFrameStats.h
new file mode 100644
index 00000000..e11feb6d
--- /dev/null
+++ b/Source/WsxFrameStats.h
@@ -0,0 +1,126 @@
+#pragma once
+
+#include <atomic>
+#include "Types.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+//Per-frame timings for the page (WebStationX): what each emulated frame cost on the VM thread and each
+//presented picture on the GS thread, kept in rings the page reads straight out of shared memory, so a
+//stutter can be pinned on the JIT, the disc, the GS, or plain emulation work.
+namespace WsxFrameStats
+{
+	enum
+	{
+		RING_SIZE = 512,
+	};
+
+	struct VM_FRAME
+	{
+		double at;      //ms (emscripten_get_now) at vblank start
+		float frameMs;  //since the previous vblank start
+		float sleepMs;  //frame limiter sleep
+		float jitMs;    //compiling guest code
+		float discMs;   //blocked on disc data
+		float gsWaitMs; //blocked on the GS thread (it may only run 2 frames behind)
+		float reserved;
+	};
+	static_assert(sizeof(VM_FRAME) == 32);
+
+	struct GS_FRAME
+	{
+		double at;    //ms at present
+		float busyMs; //GS thread busy since the previous present
+		float idleMs; //GS thread waiting for work
+	};
+	static_assert(sizeof(GS_FRAME) == 16);
+
+	struct STATE
+	{
+		std::atomic<uint32> vmCount; //entries written; entry i lives at [i % RING_SIZE]
+		std::atomic<uint32> gsCount;
+		uint32 reserved[2];
+		VM_FRAME vm[RING_SIZE];
+		GS_FRAME gs[RING_SIZE];
+	};
+
+	inline STATE g_state = {};
+
+	//Running totals in microseconds, added to by the threads doing the work.
+	inline std::atomic<uint64> g_jitUs = 0;
+	inline std::atomic<uint64> g_discUs = 0;
+	inline std::atomic<uint64> g_vmGsWaitUs = 0;
+	inline std::atomic<uint64> g_vmSleepUs = 0;
+	inline std::atomic<uint64> g_gsIdleUs = 0;
+
+	inline double Now()
+	{
+#ifdef __EMSCRIPTEN__
+		return emscripten_get_now();
+#else
+		return 0;
+#endif
+	}
+
+	//Measures a scope into one of the totals.
+	class CScope
+	{
+	public:
+		explicit CScope(std::atomic<uint64>& total)
+		    : m_total(total)
+		    , m_start(Now())
+		{
+		}
+		~CScope()
+		{
+			m_total += static_cast<uint64>((Now() - m_start) * 1000.0);
+		}
+
+	private:
+		std::atomic<uint64>& m_total;
+		double m_start;
+	};
+
+	//VM thread, at every vblank start.
+	inline void MarkVmFrame()
+	{
+		static double lastAt = 0;
+		static uint64 lastSleep = 0, lastJit = 0, lastDisc = 0, lastGsWait = 0;
+		double now = Now();
+		uint64 sleep = g_vmSleepUs, jit = g_jitUs, disc = g_discUs, gsWait = g_vmGsWaitUs;
+		uint32 index = g_state.vmCount.load(std::memory_order_relaxed);
+		auto& frame = g_state.vm[index % RING_SIZE];
+		frame.at = now;
+		frame.frameMs = lastAt ? static_cast<float>(now - lastAt) : 0;
+		frame.sleepMs = static_cast<float>(sleep - lastSleep) / 1000.0f;
+		frame.jitMs = static_cast<float>(jit - lastJit) / 1000.0f;
+		frame.discMs = static_cast<float>(disc - lastDisc) / 1000.0f;
+		frame.gsWaitMs = static_cast<float>(gsWait - lastGsWait) / 1000.0f;
+		g_state.vmCount.store(index + 1, std::memory_order_release);
+		lastAt = now;
+		lastSleep = sleep;
+		lastJit = jit;
+		lastDisc = disc;
+		lastGsWait = gsWait;
+	}
+
+	//GS thread, at every present.
+	inline void MarkGsFrame()
+	{
+		static double lastAt = 0;
+		static uint64 lastIdle = 0;
+		double now = Now();
+		uint64 idle = g_gsIdleUs;
+		float intervalMs = lastAt ? static_cast<float>(now - lastAt) : 0;
+		float idleMs = static_cast<float>(idle - lastIdle) / 1000.0f;
+		uint32 index = g_state.gsCount.load(std::memory_order_relaxed);
+		auto& frame = g_state.gs[index % RING_SIZE];
+		frame.at = now;
+		frame.idleMs = idleMs;
+		frame.busyMs = (intervalMs > idleMs) ? (intervalMs - idleMs) : 0;
+		g_state.gsCount.store(index + 1, std::memory_order_release);
+		lastAt = now;
+		lastIdle = idle;
+	}
+}
