+EM_JS_DEPS(wsxGsYield, "$getWasmTableEntry");
+// Runs fn(arg) on this worker once its event loop had a turn. A MessageChannel instead of setTimeout,
+// which the browser clamps to 4 ms when callbacks keep scheduling each other.
+// clang-format off
+EM_JS(void, wsx_gs_yield, (uintptr_t fn, void* arg), {
+	let channel = globalThis.__wsxGsYield;
+	if(!channel)
+	{
+		channel = globalThis.__wsxGsYield = new MessageChannel();
+		channel.port1.onmessage = () => {
+			const next = channel.next;
+			channel.next = null;
+			if(next) next();
+		};
+	}
+	channel.next = () => getWasmTableEntry(fn)(arg);
+	channel.port2.postMessage(0);
+});
+// clang-format on
+#endif
 #include "Log.h"
 #include "../states/MemoryStateFile.h"
 #include "../states/RegisterStateFile.h"
@@ -2116,9 +2142,19 @@ void CGSHandler::WriteToDelayedRegister(uint32 address, uint32 value, DELAYED_RE
 
 void CGSHandler::ThreadProc()
 {
+#ifdef __EMSCRIPTEN__
+	//Browsers recycle each presented picture's GPU buffer on the presenting thread's event loop: a worker
+	//that never returns to it leaks one frame of video memory per picture (gigabytes within minutes, then
+	//the GPU process dies and the picture goes black). So the GS loop runs in slices on the event loop.
+	ThreadSlice(this);
+	emscripten_unwind_to_js_event_loop();
+#endif
 	while(!m_threadDone)
 	{
-		m_mailBox.WaitForCall();
+		{
+			WsxFrameStats::CScope idleScope(WsxFrameStats::g_gsIdleUs);
+			m_mailBox.WaitForCall();
+		}
 		while(m_mailBox.IsPending())
 		{
 			m_mailBox.ReceiveCall();
@@ -2126,6 +2162,33 @@ void CGSHandler::ThreadProc()
 	}
 }
 
+#ifdef __EMSCRIPTEN__
+//Processes calls until a picture went out or 50 ms passed, then schedules itself after an event loop turn.
+void CGSHandler::ThreadSlice(void* param)
+{
+	auto self = reinterpret_cast<CGSHandler*>(param);
+	double start = WsxFrameStats::Now();
+	uint32 presents = WsxFrameStats::g_state.gsCount.load();
+	while(!self->m_threadDone)
+	{
+		{
+			WsxFrameStats::CScope idleScope(WsxFrameStats::g_gsIdleUs);
+			self->m_mailBox.WaitForCall(10);
+		}
+		while(self->m_mailBox.IsPending())
+		{
+			self->m_mailBox.ReceiveCall();
+		}
+		if((WsxFrameStats::g_state.gsCount.load() != presents) || ((WsxFrameStats::Now() - start) > 50.0))
+		{
+			wsx_gs_yield(reinterpret_cast<uintptr_t>(&CGSHandler::ThreadSlice), self);
+			return;
+		}
+	}
+	pthread_exit(nullptr);
+}
+#endif
+
 void CGSHandler::SendGSCall(const CMailBox::FunctionType& function, bool waitForCompletion, bool forceWaitForCompletion)
 {
 	if(!m_gsThreaded)
@@ -2133,7 +2196,13 @@ void CGSHandler::SendGSCall(const CMailBox::FunctionType& function, bool waitFor
 		waitForCompletion = false;
 	}
 	waitForCompletion |= forceWaitForCompletion;
-	m_mailBox.SendCall(function, waitForCompletion);
+	if(waitForCompletion)
+	{
+		WsxFrameStats::CScope waitScope(WsxFrameStats::g_vmGsWaitUs);
+		m_mailBox.SendCall(function, true);
+		return;
+	}
+	m_mailBox.SendCall(function, false);
 }
 
