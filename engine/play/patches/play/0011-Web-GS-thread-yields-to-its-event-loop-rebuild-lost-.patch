 	const bitmap = canvas.transferToImageBitmap();
 	// cmd 9 = Emscripten's "callHandler" worker message: the main thread runs Module[handler](...args).
 	// The WebStationX core build script checks the generated glue still handles it this way.
 	postMessage({ cmd: 9, handler: 'wsxPresent', args: [bitmap] }, [bitmap]);
