+	snprintf(text, sizeof(text), "{\"mode\":%u,\"drains\":%llu,\"drainWaitMs\":%.1f,\"vblankWaitMs\":%.1f,\"ringFull\":%llu,\"records\":%llu,\"busyMs\":%.1f,\"stallMs\":%.1f,\"idleMs\":%.1f}",
 	         CVpu1Thread::g_mode.load(), (unsigned long long)stats.drains.load(), stats.drainWaitUs.load() / 1000.0,
 	         stats.vblankWaitUs.load() / 1000.0, (unsigned long long)stats.ringFull.load(), (unsigned long long)stats.records.load(),
-	         stats.busyUs.load() / 1000.0);
+	         stats.busyUs.load() / 1000.0, stats.stallUs.load() / 1000.0, stats.idleUs.load() / 1000.0);
 	std::string result = text;
 	result.pop_back();
