+std::string disassembleVu1(uint32 address, int count)
+{
+	std::string result;
+	auto& vu1 = g_virtualMachine->m_ee->m_VU1;
+	for(int i = 0; i < count; i++)
+	{
+		uint32 pc = address + i * 4;
+		uint32 opcode = vu1.m_pMemoryMap->GetInstruction(pc);
+		char mnemonic[256] = {}, operands[256] = {};
+		vu1.m_pArch->GetInstructionMnemonic(&vu1, pc, opcode, mnemonic, sizeof(mnemonic));
+		vu1.m_pArch->GetInstructionOperands(&vu1, pc, opcode, operands, sizeof(operands));
+		char line[600];
+		snprintf(line, sizeof(line), "%04X  %08X  %-8s %s\n", pc, opcode, mnemonic, operands);
+		result += line;
+	}
+	return result;
+}
+
+// VU1 program counter (the VPU1 thread's, sampled like the EE's) and its micro memory, for profiling microprograms.
+uintptr_t getVu1PcAddress()
+{
+	return reinterpret_cast<uintptr_t>(&g_virtualMachine->m_ee->m_VU1.m_State.nPC);
+}
+
+uintptr_t getVu1MicroMemAddress()
+{
+	return reinterpret_cast<uintptr_t>(g_virtualMachine->m_ee->m_microMem1);
+}
