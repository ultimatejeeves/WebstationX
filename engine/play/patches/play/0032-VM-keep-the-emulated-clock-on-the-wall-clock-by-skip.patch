+// Whether the emulated clock keeps up with the wall clock by skipping EE cycles when the machine can't
+// emulate in real time (CPS2VM::TakeCatchUpTicks). On by default; off, a slow machine slows the console down.
+void setCatchUp(bool enabled)
+{
+	g_virtualMachine->SendVmCall([enabled]() { g_virtualMachine->SetCatchUp(enabled); });
+}
