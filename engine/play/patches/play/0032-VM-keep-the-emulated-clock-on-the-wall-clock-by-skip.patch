+double CFrameLimiter::GetLatenessUs(double fraction) const
+{
+	if(!m_hasDeadline || (m_minFrameDuration.count() == 0)) return 0;
+	auto now = std::chrono::high_resolution_clock::now();
+	double sinceDeadlineUs = std::chrono::duration<double, std::micro>(now - m_nextDeadline).count();
+	return sinceDeadlineUs - (fraction * static_cast<double>(m_minFrameDuration.count()));
+}
+
+void CFrameLimiter::Rebase(double fraction)
+{
+	if(!m_hasDeadline) return;
+	auto offset = std::chrono::microseconds(static_cast<int64>(fraction * static_cast<double>(m_minFrameDuration.count())));
+	m_nextDeadline = std::chrono::high_resolution_clock::now() - offset;
+}
