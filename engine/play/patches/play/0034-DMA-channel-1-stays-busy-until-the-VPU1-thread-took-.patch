 	}
 }
 
+void CDMAC::SetChannelBusyHandler(unsigned int channel, const Dmac::CChannel::BusyHandler& handler)
+{
+	switch(channel)
+	{
+	case 1:
+		m_D1.SetBusyHandler(handler);
+		break;
+	case 2:
+		m_D2.SetBusyHandler(handler);
+		break;
+	default:
+		throw std::runtime_error("Unsupported channel.");
+		break;
+	}
+}
+
 bool CDMAC::IsInterruptPending() const
 {
 	uint16 mask = static_cast<uint16>((m_D_STAT & 0x63FF0000) >> 16);
@@ -180,6 +197,7 @@ void CDMAC::ResumeDMA0()
 
 void CDMAC::ResumeDMA1()
 {
+	m_D1.CheckPendingEnd();
 	m_D1.Execute();
 }
 
