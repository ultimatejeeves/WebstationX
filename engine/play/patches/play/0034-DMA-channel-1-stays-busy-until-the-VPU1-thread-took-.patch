diff --git a/Source/WsxProfile.h b/Source/WsxProfile.h
index ea05e986..1a7f0cd2 100644
--- a/Source/WsxProfile.h
+++ b/Source/WsxProfile.h
@@ -6,6 +6,20 @@
 //Where the VM thread's time goes (WebStationX): the unit being emulated right now is kept in one word
 //of shared memory, and the page samples it from another thread (cheap enough to leave on: timing each
 //unit with the clock costs a JS call per read on the web, which made the measured units twice as slow).
+#include <atomic>
+#include <cstdio>
+//Debug: lines left to log of the hand-overs between the EE and the VPU1 thread (vifTrace(n) from the page)
+inline std::atomic<int> g_wsxVifTrace{0};
+#define WSX_VIF_TRACE(...) \
+	do \
+	{ \
+		if(g_wsxVifTrace.load(std::memory_order_relaxed) > 0) \
+		{ \
+			g_wsxVifTrace.fetch_sub(1, std::memory_order_relaxed); \
+			printf("VT " __VA_ARGS__); \
+		} \
+	} while(0)
+
 namespace WsxProfile
 {
 	enum ZONE : uint32
