 void CChannel::SaveState(Framework::CZipArchiveWriter& archive)
 {
+	//(States are captured with the device's queue empty.)
+	CheckPendingEnd();
 	auto path = string_format(STATE_REGS_XML_FORMAT, m_number);
 	auto registerFile = std::make_unique<CRegisterStateFile>(path.c_str());
 	registerFile->SetRegister32(STATE_REGS_CHCR, m_CHCR);
@@ -56,6 +59,7 @@ void CChannel::SaveState(Framework::CZipArchiveWriter& archive)
 
 void CChannel::LoadState(Framework::CZipArchiveReader& archive)
 {
+	m_endPending = false;
 	auto path = string_format(STATE_REGS_XML_FORMAT, m_number);
 	CRegisterStateFile registerFile(*archive.BeginReadFile(path.c_str()));
 	m_CHCR <<= registerFile.GetRegister32(STATE_REGS_CHCR);
@@ -69,13 +73,34 @@ void CChannel::LoadState(Framework::CZipArchiveReader& archive)
 
 uint32 CChannel::ReadCHCR()
 {
-	return m_CHCR;
+	CheckPendingEnd();
+	uint32 value = m_CHCR;
+	if(m_endPending) value |= CDMAC::CHCR_STR;
+	return value;
+}
+
+void CChannel::SetBusyHandler(const BusyHandler& busyHandler)
+{
+	m_busyHandler = busyHandler;
+}
+
+void CChannel::CheckPendingEnd()
+{
+	if(m_endPending && !(m_busyHandler && m_busyHandler()))
+	{
+		m_endPending = false;
+		EndTransfer();
+	}
 }
 
 void CChannel::WriteCHCR(uint32 nValue)
 {
 	bool nSuspend = false;
 
+	//Taking the channel for something else while the device still holds the previous transfer (a download
+	//in the middle of a display list): that transfer is over as far as the channel goes
+	m_endPending = false;
+
 	//We need to check if the purpose of this write is to suspend the current transfer
 	if(m_dmac.m_D_ENABLE & CDMAC::ENABLE_CPND)
 	{
@@ -565,6 +590,16 @@ void CChannel::ClearSTR()
 {
 	m_CHCR.nSTR = ~m_CHCR.nSTR;
 
+	if(m_busyHandler && m_busyHandler())
+	{
+		m_endPending = true;
+		return;
+	}
+	EndTransfer();
+}
+
+void CChannel::EndTransfer()
+{
 	//Set interrupt
 	m_dmac.m_D_STAT |= (1 << m_number);
 
