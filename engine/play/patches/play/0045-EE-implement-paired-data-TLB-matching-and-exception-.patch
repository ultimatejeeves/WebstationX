 void CPs2VmJs::CreateVM()
 {
+	Jitter::CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&Cop0_TLBRead), "_Cop0_TLBRead", "vi");
+	Jitter::CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&Cop0_TLBWrite), "_Cop0_TLBWrite", "vi");
+	Jitter::CWasmFunctionRegistry::RegisterFunction(reinterpret_cast<uintptr_t>(&Cop0_TLBProbe), "_Cop0_TLBProbe", "vi");
