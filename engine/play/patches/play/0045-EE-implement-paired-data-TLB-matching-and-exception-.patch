@@ -62,11 +63,11 @@ void CCOP_SCU::CompileInstruction(uint32 nAddress, CMipsJitter* codeGen, CMIPS*
 	((this)->*(m_pOpGeneral[(m_nOpcode >> 21) & 0x1F]))();
 }
 
-void CCOP_SCU::HandleTLBRead(CMIPS* context)
+extern "C" void Cop0_TLBRead(CMIPS* context)
 {
 	uint32 index = context->m_State.nCOP0[CCOP_SCU::INDEX];
-	assert(index < MIPSSTATE::TLB_ENTRY_MAX);
-	index &= (MIPSSTATE::TLB_ENTRY_MAX - 1);
+	index &= 0x3F;
+	if(index >= MIPSSTATE::TLB_ENTRY_MAX) return;
 
 	const auto& entry = context->m_State.tlbEntries[index];
 	context->m_State.nCOP0[CCOP_SCU::ENTRYLO0] = entry.entryLo0;
@@ -75,17 +76,24 @@ void CCOP_SCU::HandleTLBRead(CMIPS* context)
 	context->m_State.nCOP0[CCOP_SCU::PAGEMASK] = entry.pageMask;
 }
 
-void CCOP_SCU::HandleTLBWrite(CMIPS* context)
+extern "C" void Cop0_TLBWrite(CMIPS* context)
 {
 	uint32 index = context->m_State.nCOP0[CCOP_SCU::INDEX];
-	assert(index < MIPSSTATE::TLB_ENTRY_MAX);
-	index &= (MIPSSTATE::TLB_ENTRY_MAX - 1);
+	index &= 0x3F;
+	if(index >= MIPSSTATE::TLB_ENTRY_MAX) return;
 
 	auto& entry = context->m_State.tlbEntries[index];
 	entry.entryLo0 = context->m_State.nCOP0[CCOP_SCU::ENTRYLO0];
 	entry.entryLo1 = context->m_State.nCOP0[CCOP_SCU::ENTRYLO1];
 	entry.entryHi = context->m_State.nCOP0[CCOP_SCU::ENTRYHI];
-	entry.pageMask = context->m_State.nCOP0[CCOP_SCU::PAGEMASK];
+	entry.pageMask = context->m_State.nCOP0[CCOP_SCU::PAGEMASK] & 0x01FFE000;
+	entry.entryHi &= ~(entry.pageMask | 0x1F00);
+	// Hardware stores one G bit, formed from both EntryLo G bits.
+	if(!(entry.entryLo0 & entry.entryLo1 & CCOP_SCU::ENTRYLO_GLOBAL))
+	{
+		entry.entryLo0 &= ~CCOP_SCU::ENTRYLO_GLOBAL;
+		entry.entryLo1 &= ~CCOP_SCU::ENTRYLO_GLOBAL;
+	}
 }
 
 //////////////////////////////////////////////////
@@ -240,19 +248,35 @@ void CCOP_SCU::BC0FL()
 void CCOP_SCU::TLBR()
 {
 	m_codeGen->PushCtx();
-	m_codeGen->Call(reinterpret_cast<void*>(&CCOP_SCU::HandleTLBRead), 1, Jitter::CJitter::RETURN_VALUE_NONE);
+	m_codeGen->Call(reinterpret_cast<void*>(&Cop0_TLBRead), 1, Jitter::CJitter::RETURN_VALUE_NONE);
 }
 
 //02
 void CCOP_SCU::TLBWI()
 {
 	m_codeGen->PushCtx();
-	m_codeGen->Call(reinterpret_cast<void*>(&CCOP_SCU::HandleTLBWrite), 1, Jitter::CJitter::RETURN_VALUE_NONE);
+	m_codeGen->Call(reinterpret_cast<void*>(&Cop0_TLBWrite), 1, Jitter::CJitter::RETURN_VALUE_NONE);
+}
+
+extern "C" void Cop0_TLBProbe(CMIPS* context)
+{
+	auto& state = context->m_State;
+	state.nCOP0[CCOP_SCU::INDEX] = 0x80000000;
+	for(uint32 index = 0; index < MIPSSTATE::TLB_ENTRY_MAX; ++index)
+	{
+		if(EeTlb::Matches(state.tlbEntries[index], state.nCOP0[CCOP_SCU::ENTRYHI], state.nCOP0[CCOP_SCU::ENTRYHI]))
+		{
+			state.nCOP0[CCOP_SCU::INDEX] = index;
+			break;
+		}
+	}
 }
 
 //08
 void CCOP_SCU::TLBP()
 {
+	m_codeGen->PushCtx();
+	m_codeGen->Call(reinterpret_cast<void*>(&Cop0_TLBProbe), 1, Jitter::CJitter::RETURN_VALUE_NONE);
 }
 
