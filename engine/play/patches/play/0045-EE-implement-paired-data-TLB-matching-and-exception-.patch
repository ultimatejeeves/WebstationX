+		uint32 entryLo = EeTlb::EntryLo(*entry, vaddrLo);
+		uint32 pfn = (entryLo & 0x03FFFFC0) << 6;
+		return (pfn & ~mask) | (vaddrLo & mask);
 	}
-	//Shouldn't come here
