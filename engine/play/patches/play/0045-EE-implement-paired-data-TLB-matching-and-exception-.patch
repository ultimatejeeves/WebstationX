diff --git a/Source/MIPSInstructionFactory.cpp b/Source/MIPSInstructionFactory.cpp
index 43a57650..d71dbfbf 100644
--- a/Source/MIPSInstructionFactory.cpp
+++ b/Source/MIPSInstructionFactory.cpp
@@ -44,6 +44,17 @@ extern "C" uint32 TLBExceptionChecker_Proxy(CMIPS* context, uint32 vaddrLo, uint
 	return context->m_TLBExceptionChecker(context, vaddrLo, isWrite);
 }
 
+// The checker records the fault address first; EPC/BD depend on the instruction
+// position and must remain untouched when entering a nested exception.
+extern "C" void TLBException_SetPC(CMIPS* context, uint32 pc, uint32 delaySlot)
+{
+	auto& state = context->m_State;
+	if(state.nCOP0[CCOP_SCU::STATUS] & CMIPS::STATUS_EXL) return;
+	bool delayed = delaySlot || state.nDelayedJumpAddr != MIPS_INVALID_PC;
+	state.nCOP0[CCOP_SCU::EPC] = delayed ? pc - 4 : pc;
+	state.nCOP0[CCOP_SCU::CAUSE] = (state.nCOP0[CCOP_SCU::CAUSE] & ~0x80000000U) | (delayed ? 0x80000000U : 0);
+}
+
 void CMIPSInstructionFactory::CheckTLBExceptions(bool isWrite)
 {
 	if(!m_pCtx->HasTLBExceptionChecks()) return;
@@ -71,10 +82,12 @@ void CMIPSInstructionFactory::CheckTLBExceptions(bool isWrite)
 	m_codeGen->PushCst(MIPS_EXCEPTION_NONE);
 	m_codeGen->BeginIf(Jitter::CONDITION_NE);
 	{
+		m_codeGen->PushCtx();
 		m_codeGen->PushRel(offsetof(CMIPS, m_State.nPC));
 		m_codeGen->PushCst(m_instrPosition);
 		m_codeGen->Add();
-		m_codeGen->PullRel(offsetof(CMIPS, m_State.nCOP0[CCOP_SCU::EPC]));
+		m_codeGen->PushCst(m_instrPosition >= 4 && m_pCtx->IsBranch(m_nAddress - 4));
+		m_codeGen->Call(reinterpret_cast<void*>(&TLBException_SetPC), 3, Jitter::CJitter::RETURN_VALUE_NONE);
 		m_codeGen->JumpTo(reinterpret_cast<void*>(&HandleTLBException));
 	}
 	m_codeGen->EndIf();
diff --git a/Source/ee/EeTlb.h b/Source/ee/EeTlb.h
new file mode 100644
index 00000000..359aa468
--- /dev/null
+++ b/Source/ee/EeTlb.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "../MIPS.h"
+#include "../COP_SCU.h"
+
+// Shared by translation, permission checks and TLBP. PageMask covers both pages.
+namespace EeTlb
+{
+inline uint32 PairMask(const TLBENTRY& entry)
+{
+	return (entry.pageMask & 0x01FFE000) | 0x1FFF;
+}
+
+inline bool Matches(const TLBENTRY& entry, uint32 address, uint32 asid)
+{
+	bool global = (entry.entryLo0 & entry.entryLo1 & CCOP_SCU::ENTRYLO_GLOBAL) != 0;
+	return ((address ^ entry.entryHi) & ~PairMask(entry)) == 0 &&
+	       (global || ((entry.entryHi ^ asid) & 0xFF) == 0);
+}
+
+inline const TLBENTRY* Find(const MIPSSTATE& state, uint32 address)
+{
+	for(const auto& entry : state.tlbEntries)
+	{
+		if(Matches(entry, address, state.nCOP0[CCOP_SCU::ENTRYHI])) return &entry;
+	}
+	return nullptr;
+}
+
+inline uint32 PageSize(const TLBENTRY& entry) { return (PairMask(entry) + 1) >> 1; }
+inline uint32 EntryLo(const TLBENTRY& entry, uint32 address)
+{
+	return (address & PageSize(entry)) ? entry.entryLo1 : entry.entryLo0;
+}
+}
