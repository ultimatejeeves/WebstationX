 }
 
-uint64 CJsDiscImageDeviceStream::Read(void* buffer, uint64 size)
+CJsDiscImageDeviceStream::SLOT* CJsDiscImageDeviceStream::FindSlot(int64 block)
 {
-	if(size == 0) return 0;
+	for(auto& slot : m_slots)
