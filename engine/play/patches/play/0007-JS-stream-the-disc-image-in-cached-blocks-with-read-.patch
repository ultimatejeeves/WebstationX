From 3280efa840aa8f6b1595bd2742ba63a3be4a22e2 Mon Sep 17 00:00:00 2001
From: ultimatejeeves <ultimatejeeves@users.noreply.github.com>
Date: Tue, 29 Sep 2026 10:46:56 -0400
Subject: [PATCH 07/43] JS: stream the disc image in cached blocks with
 read-ahead

The disc stream made a synchronous round trip to the page's main thread for every read (every CHD
hunk), then polled the page every 100us with more round trips until the data landed. The VM thread
stalled on every read, for as long as the main thread took to answer, and for the whole network
fetch when the data wasn't there yet.

Blocks of 1 MiB now live in a small cache in the wasm heap. Missing blocks, and the next few for
read-ahead, are requested from the page asynchronously; the page writes them in place and wakes the
VM with Atomics.notify. The VM only waits when data is really missing.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Source/Js_DiscImageDeviceStream.cpp | 163 ++++++++++++++++++++++++----
 Source/Js_DiscImageDeviceStream.h   |  42 ++++++-
 2 files changed, 182 insertions(+), 23 deletions(-)

diff --git a/Source/Js_DiscImageDeviceStream.cpp b/Source/Js_DiscImageDeviceStream.cpp
index 71d60516..891bd635 100644
--- a/Source/Js_DiscImageDeviceStream.cpp
+++ b/Source/Js_DiscImageDeviceStream.cpp
@@ -1,8 +1,39 @@
 #include "Js_DiscImageDeviceStream.h"
 #include <stdexcept>
 #include <cassert>
+#include <cstring>
+#include <algorithm>
 #include <emscripten.h>
-#include <unistd.h>
+#include <emscripten/threading.h>
+#include <chrono>
+
+std::atomic<uint64> g_discWaitMicroseconds = 0;
+
+CJsDiscImageDeviceStream::CJsDiscImageDeviceStream()
+{
+	m_size = static_cast<uint64>(MAIN_THREAD_EM_ASM_DOUBLE({ return Module.discImageDevice.getFileSize(); }));
+	for(auto& slot : m_slots)
+	{
+		slot.data = reinterpret_cast<uint8*>(malloc(BLOCK_SIZE));
+	}
+}
+
+CJsDiscImageDeviceStream::~CJsDiscImageDeviceStream()
+{
+	for(auto& slot : m_slots)
+	{
+		//The page still owns a pending slot's buffer: give it a moment to land (the page answers
+		//right away once its disc is closed), and leak the buffer if it doesn't.
+		for(int i = 0; (slot.state.load() == SLOT_PENDING) && (i < 50); i++)
+		{
+			emscripten_futex_wait(&slot.state, SLOT_PENDING, 100.0);
+		}
+		if(slot.state.load() != SLOT_PENDING)
+		{
+			free(slot.data);
+		}
+	}
+}
 
