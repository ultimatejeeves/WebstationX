+std::string getVpu1Stats()
+{
+	auto& stats = CVpu1Thread::g_stats;
+	std::string reasons = "[";
+	for(unsigned int i = 0; i < CVpu1Thread::DRAIN_REASON_COUNT; i++)
+	{
+		if(i != 0) reasons += ",";
+		reasons += "[" + std::to_string(stats.waitsByReason[i].load()) + "," + std::to_string(stats.waitUsByReason[i].load() / 1000) + "]";
+	}
+	reasons += "]";
+	char text[512];
+	snprintf(text, sizeof(text), "{\"mode\":%u,\"drains\":%llu,\"drainWaitMs\":%.1f,\"vblankWaitMs\":%.1f,\"ringFull\":%llu,\"records\":%llu,\"busyMs\":%.1f}",
+	         CVpu1Thread::g_mode.load(), (unsigned long long)stats.drains.load(), stats.drainWaitUs.load() / 1000.0,
+	         stats.vblankWaitUs.load() / 1000.0, (unsigned long long)stats.ringFull.load(), (unsigned long long)stats.records.load(),
+	         stats.busyUs.load() / 1000.0);
+	std::string result = text;
+	result.pop_back();
+	return result + ",\"waitsByReason\":" + reasons + "}";
+}
