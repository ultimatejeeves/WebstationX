+void CSubSystem::StopVpu1Thread()
+{
+	if(!m_vpu1Thread) return;
+	//The executor's code belongs to the thread's function table.
+	m_vpu1Thread->RunSync([this]() {
+		m_VU1.m_executor.reset();
+		m_VU1.m_emptyBlockHandler = nullptr;
+	});
+	m_vpu1Thread.reset();
+}
+
+void CSubSystem::SyncVpu1(uint32 reason)
+{
+	if(m_vpu1Thread)
+	{
+		m_vpu1Thread->Drain(static_cast<CVpu1Thread::DRAIN_REASON>(reason));
+	}
+}
+
+void CSubSystem::DeliverVpu1Interrupts(uint32 lines)
+{
+	if(lines & (1 << CINTC::INTC_LINE_VIF1))
+	{
+		//Raised after a delay, like the VIF does itself (CVif::CountTicks)
+		m_vpu1->GetVif().ScheduleInterrupt();
+	}
+	if(lines & (1 << CINTC::INTC_LINE_VU1))
+	{
+		m_intc.AssertLine(CINTC::INTC_LINE_VU1);
+	}
+	if(lines & (1 << CINTC::INTC_LINE_GS))
+	{
+		m_intc.AssertLine(CINTC::INTC_LINE_GS);
+	}
+}
+
+uint32 CSubSystem::Vif1ThreadedReceiveDMA(uint32 address, uint32 qwc, uint32 direction, bool tagIncluded)
+{
+	if(direction == Dmac::CChannel::CHCR_DIR_TO)
+	{
+		//GS to memory: done here, once the thread is done with what it was sent
+		m_vpu1Thread->Drain(CVpu1Thread::DRAIN_GS_READBACK);
+		return m_vpu1->GetVif().ReceiveDMA(address, qwc, direction, tagIncluded);
+	}
+	return m_vpu1Thread->SendVif1Dma(address, qwc, tagIncluded);
+}
+
+//Display settings and the bus direction go out in order with the GIF data (the flip at the end of a
+//frame must see what the game set before it). The event and interrupt registers are the EE's: at once.
+void CSubSystem::WriteGsPrivRegister(uint32 address, uint32 value)
+{
+	if(!m_vpu1Thread)
+	{
+		m_gs->WritePrivRegister(address, value);
+		return;
+	}
+	switch(address & ~0x0F)
+	{
+	case CGSHandler::GS_CSR:
+	case CGSHandler::GS_CSR_ALT:
+	case CGSHandler::GS_IMR:
+	case CGSHandler::GS_SIGLBLID:
+		m_gs->WritePrivRegister(address, value);
+		//Clearing SIGNAL lets a stalled GIF go on
+		m_vpu1Thread->Kick();
+		break;
+	default:
+		m_vpu1Thread->SendCall([this, address, value]() { m_gs->WritePrivRegister(address, value); });
+		break;
+	}
+}
+
+void CSubSystem::NotifyGsVBlank()
+{
+	if(!m_gs) return;
+	if(m_vpu1Thread)
+	{
+		m_vpu1Thread->SendVBlank([this]() { m_gs->FinishFrame(); });
+		m_gs->SignalVBlank();
+	}
+	else
+	{
+		m_gs->SetVBlank();
+	}
+}
