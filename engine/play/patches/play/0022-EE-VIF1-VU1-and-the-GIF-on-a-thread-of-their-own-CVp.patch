+++ b/Source/ee/Vpu1Thread.h
@@ -0,0 +1,193 @@
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include "Types.h"
+
+class CVpu;
+class CGIF;
+class CGSHandler;
+
+//VIF1, VU1 and the GIF on a thread of their own (WebStationX).
+//
+//Together they were ~40% of the VM thread's time, and the EE only sees their work through a few doors:
+//DMA channels 1 and 2 (plus the VIF1/GIF FIFOs) feed them, and results come back as register values,
+//VU1 memory, GS events and interrupts. So the EE thread copies what it sends into a queue and carries on
+//as if the transfer completed at once (which is what the emulator did anyway, synchronously), and it
+//waits for the queue to drain (Drain) before looking through any of the doors it could see a difference
+//through: VIF1/GIF/VU1 registers and memory, state saves. What the queue sends to the GS (drawing, the
+//display registers, the end of a frame) stays in order because only this thread feeds the GS.
+//
+//Work goes into two queues, VIF1 (also carrying calls to run on this thread in order: VU1 starts from the
+//EE, display register writes, the end of a frame) and PATH3 (GIF DMA and FIFO), processed in the order
+//they were sent. Either may stall the way the hardware would, waiting on the EE (a VIF1 interrupt stall,
+//a GS SIGNAL, PATH3 masked or the GIF busy with another path): the other keeps going, and a stall counts
+//as drained, so the EE never waits on something only it can resolve. Stalls are retried when the EE
+//touches a register (Kick).
+//
+//Synchronous mode drains after every hand-over: slow, but it emulates exactly what the single thread
+//did (the determinism check compares machine fingerprints), which is what shows the plumbing is right.
+struct VPU1_THREAD_STATS
+{
+	std::atomic<uint64> drains = 0;       //Drain calls that had to wait
+	std::atomic<uint64> drainWaitUs = 0;  //EE thread time spent waiting in them
+	std::atomic<uint64> vblankWaitUs = 0; //EE waiting for the thread to catch up a frame
+	std::atomic<uint64> ringFull = 0;     //DMA transfers refused for lack of queue room
+	std::atomic<uint64> records = 0;      //records processed
+	std::atomic<uint64> busyUs = 0;       //thread time spent processing
+	std::atomic<uint64> waitsByReason[16] = {}; //Drain calls that had to wait, by DRAIN_REASON
+	std::atomic<uint64> waitUsByReason[16] = {};
+};
+
+class CVpu1Thread
+{
+public:
+	//Why the EE waited (stats)
+	enum DRAIN_REASON : uint32
+	{
+		DRAIN_OTHER,
+		DRAIN_GIF_READ,
+		DRAIN_GIF_WRITE,
+		DRAIN_VIF1_READ,
+		DRAIN_VIF1_WRITE,
+		DRAIN_VU1_AREA,
+		DRAIN_VU1_MEMORY,
+		DRAIN_VU1_FBRST,
+		DRAIN_GS_READBACK,
+		DRAIN_STATE,
+		DRAIN_QUEUE_FULL,
+		DRAIN_SYNC_MODE,
+		DRAIN_GS_HANDLER,
+		DRAIN_REASON_COUNT,
+	};
+
+	enum MODE : uint32
+	{
+		MODE_OFF,
+		MODE_SYNCHRONOUS,
+		MODE_ASYNCHRONOUS,
+	};
+
+	//Read when the EE subsystem is created (the page sets it before starting the VM).
+	static inline std::atomic<uint32> g_mode = MODE_OFF;
+
+	static inline VPU1_THREAD_STATS g_stats;
+
+	typedef std::function<void(uint32)> InterruptHandler;
+
+	CVpu1Thread(CVpu&, CGIF&, uint8* ram, uint8* spr);
+	~CVpu1Thread();
+
+	bool IsSynchronous() const
+	{
+		return m_synchronous;
+	}
+
+	//The thread itself?
+	bool IsCurrentThread() const;
+
+	//EE thread: interrupts the thread raised are handed to this (bitmask of INTC lines).
+	void SetInterruptHandler(InterruptHandler);
+
+	//EE thread: hand work over. The DMA functions return how many qwords were taken (0 when the queue
+	//is full: the DMA channel retries later, as it does for a busy device).
+	uint32 SendVif1Dma(uint32 address, uint32 qwc, bool tagIncluded);
+	void SendVif1FifoWrite(uint32 address, uint32 value);
+	uint32 SendPath3Dma(uint32 address, uint32 qwc, bool tagIncluded);
+	void SendGifFifoWrite(uint32 address, uint32 value);
+	//Runs on the thread after everything sent before it (and PATH3 sent before it, unless stalled).
+	void SendCall(std::function<void()>);
+	//End of an emulated frame: runs `finish` (the GS Finish/Flip) in order. Waits while the thread is
+	//more than a frame behind, so the EE can't run away from the GS.
+	void SendVBlank(std::function<void()> finish);
+
+	//EE thread: wait until the thread did everything it was sent (or is stalled on the EE). Afterwards,
+	//and until the EE sends or kicks again, the thread doesn't touch any state.
+	void Drain(DRAIN_REASON = DRAIN_OTHER);
+	//Drain, then run on the thread (out of band: also while stalled) and wait for it.
+	void RunSync(const std::function<void()>&);
+	//Drop everything queued (state load, reset).
+	void Discard();
+	//Something the thread may be stalled on changed.
+	void Kick();
+
+	//EE thread: interrupts raised since the last call (async mode delivers them from CountTicks).
+	uint32 TakeInterrupts();
+
+	//Thread side: raise an INTC line on the EE.
+	void PostInterrupt(uint32 line);
+	//Thread side: PATH3 was unmasked by the VIF1 data being processed; go on with the PATH3 data sent
+	//before it (what DMA channel 2 held back).
+	void ResumePath3();
+
+private:
+	struct RECORD;
+	class CRing;
+
+	enum KIND : uint32
+	{
+		KIND_PAD,
+		KIND_VIF1_DMA,
+		KIND_VIF1_FIFO,
+		KIND_PATH3_DMA,
+		KIND_GIF_FIFO,
+		KIND_CALL,
+		KIND_VBLANK,
+	};
+
+	void ThreadProc();
+	void ProcessQueues();
+	bool TryVif1(RECORD&);
+	bool TryPath3(RECORD&);
+	void CompleteRecord(CRing&);
+	void Publish(CRing&, RECORD*);
+	void AfterSend();
+	bool IsQuiescent() const;
+	void DeliverInterrupts();
+
+	CVpu& m_vpu1;
+	CGIF& m_gif;
+	uint8* m_ram = nullptr;
+	uint8* m_spr = nullptr;
+	bool m_synchronous = false;
+
+	std::unique_ptr<CRing> m_vif1Ring;
+	std::unique_ptr<CRing> m_path3Ring;
+
+	//Sequence numbers: every record gets the next one; `m_completed` counts records done.
+	uint64 m_nextSeq = 1;
+	std::atomic<uint64> m_sent = 0;
+	std::atomic<uint64> m_completed = 0;
+
+	//Current partially processed records.
+	bool m_vif1StreamSet = false;
+	uint64 m_vif1Seq = 0; //record being processed
+	uint32 m_path3Offset = 0;
+
+	std::mutex m_mutex;
+	std::condition_variable m_workCondition; //thread waits for work or a kick
+	std::condition_variable m_idleCondition; //EE waits for the thread
+	std::atomic<bool> m_parked = false;
+	uint64 m_parkedSent = 0;
+	uint64 m_parkedKicks = 0;
+	std::atomic<uint64> m_kicks = 0;
+	std::function<void()> m_syncCall;
+	bool m_syncCallDone = false;
+	bool m_discard = false;
+	bool m_quit = false;
+
+	std::atomic<uint64> m_vblanksSent = 0;
+	std::atomic<uint64> m_vblanksDone = 0;
+
+	std::atomic<uint32> m_pendingInterrupts = 0;
+	InterruptHandler m_interruptHandler;
+
+	uint32 m_vif1FifoWrites = 0;
+
+	std::thread m_thread;
+	std::thread::id m_threadId;
+};
