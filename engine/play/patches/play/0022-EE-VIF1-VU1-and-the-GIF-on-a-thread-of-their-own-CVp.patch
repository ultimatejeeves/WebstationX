 	m_nCSR |= CSR_VSYNC_INT;
 	NotifyEvent(CSR_VSYNC_INT);
 }
 
+void CGSHandler::SetGifInterruptPoster(std::function<void()> poster)
+{
+	m_gifInterruptPoster = std::move(poster);
+}
+
+//SIGNAL/FINISH met in GIF data: on a GIF thread the EE's INTC is raised through the poster.
+void CGSHandler::NotifyGifEvent(uint32 eventBit)
+{
+	if(!m_gifInterruptPoster)
+	{
+		NotifyEvent(eventBit);
+		return;
+	}
+	uint32 mask = (~m_nIMR >> 8) & 0x1F;
+	if(m_intc && ((eventBit & mask) != 0))
+	{
+		m_gifInterruptPoster();
+	}
+}
