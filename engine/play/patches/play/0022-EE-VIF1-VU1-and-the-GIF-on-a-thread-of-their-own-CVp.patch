+void CSubSystem::StartVpu1Thread()
+{
+	m_vpu1Thread = std::make_unique<CVpu1Thread>(*m_vpu1, m_gif, m_ram, m_spr);
+
+	//VU1 code is compiled and run on the thread, and compiled code lives in a per-thread function table:
+	//the executor (it compiles its empty block when built) is rebuilt there.
+	m_VU1.m_emptyBlockHandler = nullptr;
+	m_VU1.m_executor.reset();
+	m_vpu1Thread->RunSync([this]() { m_VU1.m_executor = std::make_unique<CVuExecutor>(m_VU1, PS2::MICROMEM1SIZE); });
+
+	m_vpu1Thread->SetInterruptHandler([this](uint32 lines) { DeliverVpu1Interrupts(lines); });
+	m_vpu1->GetVif().SetInterruptPoster([this]() { m_vpu1Thread->PostInterrupt(CINTC::INTC_LINE_VIF1); });
+	m_gif.SetPath3ResumeHandler([this]() { m_vpu1Thread->ResumePath3(); });
+	if(m_gs)
+	{
+		m_gs->SetGifInterruptPoster([this]() { m_vpu1Thread->PostInterrupt(CINTC::INTC_LINE_GS); });
+	}
+
+	//The EE looking at VU1 memory waits for the thread first.
+	auto sync = [this]() { m_vpu1Thread->Drain(CVpu1Thread::DRAIN_VU1_MEMORY); };
+	m_EE.m_pMemoryMap->SetPreAccessHandler(PS2::VUMEM1ADDR, sync);
+	m_EE.m_pMemoryMap->SetPreAccessHandler(PS2::MICROMEM1ADDR, sync);
+	m_dmac.m_vuMem1PreAccess = sync;
+
+	m_dmac.SetChannelTransferFunction(CDMAC::CHANNEL_ID_VIF1,
+	                                  [this](uint32 address, uint32 qwc, uint32 direction, bool tagIncluded) {
