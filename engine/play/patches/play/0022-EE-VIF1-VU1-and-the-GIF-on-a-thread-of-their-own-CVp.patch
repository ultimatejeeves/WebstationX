+#include <cassert>
+#include <cstring>
+#include <cfenv>
+#include "Vpu1Thread.h"
+#include "Vpu.h"
+#include "Vif.h"
+#include "GIF.h"
+#include "../Ps2Const.h"
+#include "../WsxProfile.h"
+#include "../WsxFrameStats.h"
+#include "../WsxJitCache.h"
+#include "Jitter_CodeGen_Wasm.h"
+
+//A record in a ring: header, then the payload (16 byte aligned, never split by the ring's end).
+struct CVpu1Thread::RECORD
+{
+	uint32 kind;
+	uint32 size; //payload bytes
+	uint64 seq;
+	union
+	{
+		struct
+		{
+			uint32 tagIncluded;
+		} dma;
+		struct
+		{
+			uint32 address;
+			uint32 value;
+		} fifo;
+		struct
+		{
+			std::function<void()>* function;
+		} call;
+	};
+	uint32 reserved[2];
+
+	uint8* GetPayload()
+	{
+		return reinterpret_cast<uint8*>(this + 1);
+	}
+};
+
+//Single producer (EE), single consumer (the thread) ring of records.
+class CVpu1Thread::CRing
+{
+public:
+	explicit CRing(uint32 size)
+	    : m_size(size)
+	    , m_buffer(new uint8[size + sizeof(RECORD)])
+	{
+		assert((size & (size - 1)) == 0);
+	}
+
+	//Producer: room for a record with that payload, or nullptr when full. Publish it with Commit.
+	RECORD* Allocate(uint32 payloadSize)
+	{
+		uint32 recordSize = sizeof(RECORD) + ((payloadSize + 0xF) & ~0xF);
+		assert(recordSize <= (m_size / 4));
+		uint32 write = m_write.load(std::memory_order_relaxed);
+		uint32 read = m_read.load(std::memory_order_acquire);
+		uint32 offset = write & (m_size - 1);
+		uint32 contiguous = m_size - offset;
+		uint32 needed = recordSize;
+		if(contiguous < recordSize)
+		{
+			//Pad to the start: a record is never split
+			needed += contiguous;
+		}
+		if((m_size - (write - read)) < needed)
+		{
+			return nullptr;
+		}
+		if(contiguous < recordSize)
+		{
+			auto pad = reinterpret_cast<RECORD*>(m_buffer.get() + offset);
+			pad->kind = KIND_PAD;
+			pad->size = contiguous - sizeof(RECORD);
+			//The pad's header always fits: records are multiples of 16 and the header is 32,
+			//and a remainder under the header size is covered by the spare room past the end.
+			write += contiguous;
+			m_write.store(write, std::memory_order_release);
+			offset = 0;
+		}
+		auto record = reinterpret_cast<RECORD*>(m_buffer.get() + offset);
+		record->size = payloadSize;
+		return record;
+	}
+
+	void Commit(RECORD* record)
+	{
+		uint32 recordSize = sizeof(RECORD) + ((record->size + 0xF) & ~0xF);
+		m_write.store(m_write.load(std::memory_order_relaxed) + recordSize, std::memory_order_release);
+	}
+
+	//Consumer: the oldest record, or nullptr.
+	RECORD* Head()
+	{
+		while(true)
+		{
+			uint32 read = m_read.load(std::memory_order_relaxed);
+			uint32 write = m_write.load(std::memory_order_acquire);
+			if(read == write) return nullptr;
+			auto record = reinterpret_cast<RECORD*>(m_buffer.get() + (read & (m_size - 1)));
+			if(record->kind != KIND_PAD) return record;
+			m_read.store(read + sizeof(RECORD) + record->size, std::memory_order_release);
+		}
+	}
+
+	void Pop()
+	{
+		uint32 read = m_read.load(std::memory_order_relaxed);
+		auto record = reinterpret_cast<RECORD*>(m_buffer.get() + (read & (m_size - 1)));
+		uint32 recordSize = sizeof(RECORD) + ((record->size + 0xF) & ~0xF);
+		m_read.store(read + recordSize, std::memory_order_release);
+	}
+
+	void Clear()
+	{
+		m_read.store(m_write.load(std::memory_order_acquire), std::memory_order_release);
+	}
+
+private:
+	uint32 m_size;
+	std::unique_ptr<uint8[]> m_buffer;
+	std::atomic<uint32> m_write = 0;
+	std::atomic<uint32> m_read = 0;
+};
+
+namespace
+{
+	enum
+	{
+		VIF1_RING_SIZE = 16 * 1024 * 1024,
+		PATH3_RING_SIZE = 8 * 1024 * 1024,
+		//How many frames the thread may still be working on when the EE ends another
+		MAX_VBLANKS_BEHIND = 1,
+	};
+
+	//Copies qwords out of EE memory the way the DMA channels address it (bit 31: scratchpad).
+	void CopyFromEeMemory(uint8* dst, uint8* ram, uint8* spr, uint32 address, uint32 size)
+	{
+		uint8* source = ram;
+		uint32 memorySize = PS2::EE_RAM_SIZE;
+		if(address & 0x80000000)
+		{
+			source = spr;
+			memorySize = PS2::EE_SPR_SIZE;
+		}
+		address &= (memorySize - 1);
+		while(size != 0)
+		{
+			uint32 chunk = std::min<uint32>(size, memorySize - address);
+			memcpy(dst, source + address, chunk);
+			dst += chunk;
+			size -= chunk;
+			address = 0;
+		}
+	}
+}
+
+CVpu1Thread::CVpu1Thread(CVpu& vpu1, CGIF& gif, uint8* ram, uint8* spr)
+    : m_vpu1(vpu1)
+    , m_gif(gif)
+    , m_ram(ram)
+    , m_spr(spr)
+    , m_synchronous(g_mode.load() == MODE_SYNCHRONOUS)
+    , m_vif1Ring(std::make_unique<CRing>(VIF1_RING_SIZE))
+    , m_path3Ring(std::make_unique<CRing>(PATH3_RING_SIZE))
+{
+	static_assert(sizeof(RECORD) == 32);
+	m_thread = std::thread([this]() { ThreadProc(); });
+	m_threadId = m_thread.get_id();
+}
+
+CVpu1Thread::~CVpu1Thread()
+{
+	{
+		std::lock_guard lock(m_mutex);
+		m_quit = true;
+	}
+	m_workCondition.notify_all();
+	m_thread.join();
+}
+
+bool CVpu1Thread::IsCurrentThread() const
+{
+	return std::this_thread::get_id() == m_threadId;
+}
+
+void CVpu1Thread::SetInterruptHandler(InterruptHandler handler)
+{
+	m_interruptHandler = std::move(handler);
+}
+
+void CVpu1Thread::Publish(CRing& ring, RECORD* record)
+{
+	record->seq = m_nextSeq++;
+	ring.Commit(record);
+	m_sent.store(record->seq, std::memory_order_seq_cst);
+	if(m_parked.load(std::memory_order_seq_cst))
+	{
+		std::lock_guard lock(m_mutex);
+		m_workCondition.notify_all();
+	}
+}
+
+void CVpu1Thread::AfterSend()
+{
+	if(!m_synchronous) return;
+	Drain(DRAIN_SYNC_MODE);
+	DeliverInterrupts();
+}
+
+uint32 CVpu1Thread::SendVif1Dma(uint32 address, uint32 qwc, bool tagIncluded)
+{
+	//Large transfers go over in pieces: the queue can hold several frames of them.
+	uint32 sent = 0;
+	while(sent != qwc)
+	{
+		uint32 chunk = std::min<uint32>(qwc - sent, 0x4000);
+		auto record = m_vif1Ring->Allocate(chunk * 0x10);
+		if(!record)
+		{
+			g_stats.ringFull++;
+			break;
+		}
+		record->kind = KIND_VIF1_DMA;
+		record->dma.tagIncluded = (tagIncluded && (sent == 0)) ? 1 : 0;
+		CopyFromEeMemory(record->GetPayload(), m_ram, m_spr, address + (sent * 0x10), chunk * 0x10);
+		Publish(*m_vif1Ring, record);
+		sent += chunk;
+	}
+	AfterSend();
+	return sent;
+}
+
+void CVpu1Thread::SendVif1FifoWrite(uint32 address, uint32 value)
+{
+	RECORD* record = nullptr;
+	while(!(record = m_vif1Ring->Allocate(0)))
+	{
+		Drain(DRAIN_QUEUE_FULL);
+	}
+	record->kind = KIND_VIF1_FIFO;
+	record->fifo.address = address;
+	record->fifo.value = value;
+	Publish(*m_vif1Ring, record);
+	AfterSend();
+}
+
+uint32 CVpu1Thread::SendPath3Dma(uint32 address, uint32 qwc, bool tagIncluded)
+{
+	uint32 sent = 0;
+	while(sent != qwc)
+	{
+		uint32 chunk = std::min<uint32>(qwc - sent, 0x4000);
+		auto record = m_path3Ring->Allocate(chunk * 0x10);
+		if(!record)
+		{
+			g_stats.ringFull++;
+			break;
+		}
+		record->kind = KIND_PATH3_DMA;
+		record->dma.tagIncluded = (tagIncluded && (sent == 0)) ? 1 : 0;
+		CopyFromEeMemory(record->GetPayload(), m_ram, m_spr, address + (sent * 0x10), chunk * 0x10);
+		Publish(*m_path3Ring, record);
+		sent += chunk;
+	}
+	AfterSend();
+	return sent;
+}
+
+void CVpu1Thread::SendGifFifoWrite(uint32 address, uint32 value)
+{
+	RECORD* record = nullptr;
+	while(!(record = m_path3Ring->Allocate(0)))
+	{
+		Drain(DRAIN_QUEUE_FULL);
+	}
+	record->kind = KIND_GIF_FIFO;
+	record->fifo.address = address;
+	record->fifo.value = value;
+	Publish(*m_path3Ring, record);
+	AfterSend();
+}
+
+void CVpu1Thread::SendCall(std::function<void()> function)
+{
+	RECORD* record = nullptr;
+	while(!(record = m_vif1Ring->Allocate(0)))
+	{
+		Drain(DRAIN_QUEUE_FULL);
+	}
+	record->kind = KIND_CALL;
+	record->call.function = new std::function<void()>(std::move(function));
+	Publish(*m_vif1Ring, record);
+	AfterSend();
+}
+
+void CVpu1Thread::SendVBlank(std::function<void()> finish)
+{
+	//Don't get more than a frame ahead of the thread (unless it's stalled on us).
+	if(!m_synchronous && ((m_vblanksSent.load() - m_vblanksDone.load()) >= MAX_VBLANKS_BEHIND))
+	{
+		WsxFrameStats::CScope waitScope(WsxFrameStats::g_vpu1WaitUs);
+		WsxProfile::CZone zone(WsxProfile::ZONE_WAIT);
+		std::unique_lock lock(m_mutex);
+		uint64 target = m_vblanksSent.load() - MAX_VBLANKS_BEHIND + 1;
+		double start = WsxFrameStats::Now();
+		m_idleCondition.wait(lock, [&]() {
+			return (m_vblanksDone.load() >= target) || IsQuiescent();
+		});
+		g_stats.vblankWaitUs += static_cast<uint64>((WsxFrameStats::Now() - start) * 1000.0);
+	}
+	RECORD* record = nullptr;
+	while(!(record = m_vif1Ring->Allocate(0)))
+	{
+		Drain(DRAIN_QUEUE_FULL);
+	}
+	record->kind = KIND_VBLANK;
+	record->call.function = new std::function<void()>(std::move(finish));
+	m_vblanksSent++;
+	Publish(*m_vif1Ring, record);
+	AfterSend();
+}
+
+//Caller holds m_mutex.
+bool CVpu1Thread::IsQuiescent() const
+{
+	uint64 sent = m_sent.load();
+	if(m_completed.load() == sent) return true;
+	return m_parked.load() && (m_parkedSent == sent) && (m_parkedKicks == m_kicks.load());
+}
+
+void CVpu1Thread::Drain(DRAIN_REASON reason)
+{
+	assert(!IsCurrentThread());
+	if(m_completed.load(std::memory_order_acquire) == m_sent.load(std::memory_order_relaxed)) return;
+	WsxFrameStats::CScope waitScope(WsxFrameStats::g_vpu1WaitUs);
+	WsxProfile::CZone zone(WsxProfile::ZONE_WAIT);
+	double start = WsxFrameStats::Now();
+	//Short waits are the common case: spin a little before sleeping.
+	for(unsigned int i = 0; i < 2000; i++)
+	{
+		if(m_completed.load(std::memory_order_acquire) == m_sent.load(std::memory_order_relaxed)) break;
+		if(m_parked.load() && (i > 100)) break;
+	}
+	{
+		std::unique_lock lock(m_mutex);
+		m_idleCondition.wait(lock, [&]() { return IsQuiescent(); });
+	}
+	uint64 waitedUs = static_cast<uint64>((WsxFrameStats::Now() - start) * 1000.0);
+	g_stats.drains++;
+	g_stats.drainWaitUs += waitedUs;
+	g_stats.waitsByReason[reason]++;
+	g_stats.waitUsByReason[reason] += waitedUs;
+}
+
+void CVpu1Thread::RunSync(const std::function<void()>& function)
+{
+	assert(!IsCurrentThread());
+	Drain(DRAIN_STATE);
+	std::unique_lock lock(m_mutex);
+	m_syncCall = function;
+	m_syncCallDone = false;
+	m_workCondition.notify_all();
+	m_idleCondition.wait(lock, [&]() { return m_syncCallDone; });
+	m_syncCall = nullptr;
+}
+
+void CVpu1Thread::Discard()
+{
+	assert(!IsCurrentThread());
+	Drain(DRAIN_STATE);
+	std::unique_lock lock(m_mutex);
+	m_discard = true;
+	m_workCondition.notify_all();
+	m_idleCondition.wait(lock, [&]() { return !m_discard; });
+}
+
+void CVpu1Thread::Kick()
+{
+	{
+		std::lock_guard lock(m_mutex);
+		m_kicks++;
+	}
+	m_workCondition.notify_all();
+	AfterSend();
+}
+
+void CVpu1Thread::PostInterrupt(uint32 line)
+{
+	m_pendingInterrupts.fetch_or(1 << line);
+}
+
+uint32 CVpu1Thread::TakeInterrupts()
+{
+	if(m_pendingInterrupts.load(std::memory_order_relaxed) == 0) return 0;
+	return m_pendingInterrupts.exchange(0);
+}
+
+void CVpu1Thread::DeliverInterrupts()
+{
+	uint32 lines = TakeInterrupts();
+	if(lines && m_interruptHandler)
+	{
+		m_interruptHandler(lines);
+	}
+}
+
+void CVpu1Thread::ThreadProc()
+{
+	fesetround(FE_TOWARDZERO);
+#ifdef __EMSCRIPTEN__
+	//Compiled code calls helpers through a table each thread builds for itself.
+	Jitter::CWasmFunctionRegistry::InitializeThread();
+#endif
+	WsxProfile::t_zone = &WsxProfile::g_vpu1Zone;
+
+	std::unique_lock lock(m_mutex);
+	while(!m_quit)
+	{
+		if(m_syncCall && !m_syncCallDone)
+		{
+			m_syncCall();
+			m_syncCallDone = true;
+			m_idleCondition.notify_all();
+			continue;
+		}
+		if(m_discard)
+		{
+			//Records sent before a state load or reset belong to the machine that was replaced.
+			auto discardRing = [&](CRing& ring) {
+				while(auto record = ring.Head())
+				{
+					if((record->kind == KIND_CALL) || (record->kind == KIND_VBLANK))
+					{
+						delete record->call.function;
+					}
+					if(record->kind == KIND_VBLANK) m_vblanksDone++;
+					ring.Pop();
+					m_completed++;
+				}
+			};
+			discardRing(*m_vif1Ring);
+			discardRing(*m_path3Ring);
+			m_vif1StreamSet = false;
+			m_path3Offset = 0;
+			m_discard = false;
+			m_idleCondition.notify_all();
+			continue;
+		}
+
+		uint64 kicks = m_kicks.load();
+		uint64 sent = m_sent.load(std::memory_order_seq_cst);
+		lock.unlock();
+		{
+			WsxProfile::CZone zone(WsxProfile::ZONE_OTHER);
+			double start = WsxFrameStats::Now();
+			ProcessQueues();
+			g_stats.busyUs += static_cast<uint64>((WsxFrameStats::Now() - start) * 1000.0);
+		}
+		lock.lock();
+
+		if(m_completed.load() == m_sent.load())
+		{
+			m_idleCondition.notify_all();
+		}
+		if(m_quit || m_discard || (m_syncCall && !m_syncCallDone)) continue;
+		//More work came in, or a kick (retry stalls) while processing
+		if(m_sent.load(std::memory_order_seq_cst) != sent) continue;
+		if(m_kicks.load() != kicks) continue;
+		//Nothing to do, or stalled on the EE: wait for more work or a kick.
+		m_parkedSent = sent;
+		m_parkedKicks = kicks;
+		m_parked.store(true, std::memory_order_seq_cst);
+		m_idleCondition.notify_all();
+		m_workCondition.wait(lock, [&]() {
+			return m_quit || m_discard || (m_syncCall && !m_syncCallDone) ||
+			       (m_sent.load(std::memory_order_seq_cst) != m_parkedSent) || (m_kicks.load() != m_parkedKicks);
+		});
+		m_parked.store(false);
+	}
+}
+
+//Processes records in the order they were sent while any makes progress.
+void CVpu1Thread::ProcessQueues()
+{
+	while(true)
+	{
+		auto vif1 = m_vif1Ring->Head();
+		auto path3 = m_path3Ring->Head();
+		if(!vif1 && !path3) return;
+		bool vif1First = vif1 && (!path3 || (vif1->seq < path3->seq));
+		bool progress = false;
+		if(vif1First)
+		{
+			progress = TryVif1(*vif1);
+			if(!progress && path3) progress = TryPath3(*path3);
+		}
+		else
+		{
+			progress = TryPath3(*path3);
+			if(!progress && vif1) progress = TryVif1(*vif1);
+		}
+		if(!progress) return;
+	}
+}
+
+void CVpu1Thread::CompleteRecord(CRing& ring)
+{
+	ring.Pop();
+	g_stats.records++;
+	m_completed.fetch_add(1, std::memory_order_release);
+}
+
+bool CVpu1Thread::TryVif1(RECORD& record)
+{
+	auto& vif1 = static_cast<CVif&>(m_vpu1.GetVif());
+	switch(record.kind)
+	{
+	case KIND_VIF1_DMA:
+	{
+		m_vif1Seq = record.seq;
+		if(!m_vif1StreamSet)
+		{
+			vif1.SetThreadedSource(record.GetPayload(), record.size, record.dma.tagIncluded != 0);
+			m_vif1StreamSet = true;
+		}
+		m_vpu1.RunToCompletion();
+		uint32 before = vif1.GetThreadedAvailable();
+		uint32 remaining = vif1.ProcessThreaded();
+		m_vpu1.RunToCompletion();
+		if(remaining == 0)
+		{
+			m_vif1StreamSet = false;
+			CompleteRecord(*m_vif1Ring);
+			return true;
+		}
+		return vif1.GetThreadedAvailable() != before;
+	}
+	case KIND_VIF1_FIFO:
+		m_vif1Seq = record.seq;
+		m_vpu1.RunToCompletion();
+		vif1.SetRegister(record.fifo.address, record.fifo.value);
+		m_vpu1.RunToCompletion();
+		CompleteRecord(*m_vif1Ring);
+		return true;
+	case KIND_CALL:
+	case KIND_VBLANK:
+	{
+		//Ordered after the PATH3 data sent before it, unless that is stalled.
+		if(auto path3 = m_path3Ring->Head(); path3 && (path3->seq < record.seq))
+		{
+			if(TryPath3(*path3)) return true;
+		}
+		m_vif1Seq = record.seq;
+		m_vpu1.RunToCompletion();
+		auto function = record.call.function;
+		bool isVBlank = (record.kind == KIND_VBLANK);
+		(*function)();
+		delete function;
+		m_vpu1.RunToCompletion();
+		CompleteRecord(*m_vif1Ring);
+		if(isVBlank)
+		{
+			m_vblanksDone++;
+			std::lock_guard lock(m_mutex);
+			m_idleCondition.notify_all();
+		}
+		return true;
+	}
+	default:
+		assert(false);
+		CompleteRecord(*m_vif1Ring);
+		return true;
+	}
+}
+
+void CVpu1Thread::ResumePath3()
+{
+	assert(IsCurrentThread());
+	while(auto path3 = m_path3Ring->Head())
+	{
+		if(path3->seq > m_vif1Seq) break;
+		if(!TryPath3(*path3)) break;
+	}
+}
+
+bool CVpu1Thread::TryPath3(RECORD& record)
+{
+	switch(record.kind)
+	{
+	case KIND_PATH3_DMA:
+	{
+		uint32 qwc = record.size / 0x10;
+		uint32 done = m_path3Offset / 0x10;
+		bool tagIncluded = (record.dma.tagIncluded != 0) && (m_path3Offset == 0);
+		uint32 taken = m_gif.ReceiveMemory(record.GetPayload(), record.size, m_path3Offset, qwc - done, tagIncluded);
+		m_path3Offset += taken * 0x10;
+		if(m_path3Offset == record.size)
+		{
+			m_path3Offset = 0;
+			CompleteRecord(*m_path3Ring);
+			return true;
+		}
+		return taken != 0;
+	}
+	case KIND_GIF_FIFO:
+		m_gif.SetRegister(record.fifo.address, record.fifo.value);
+		CompleteRecord(*m_path3Ring);
+		return true;
+	default:
+		assert(false);
+		CompleteRecord(*m_path3Ring);
+		return true;
+	}
+}
