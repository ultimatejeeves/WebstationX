+
+// Compiled code cache (WsxJitCache.h). The page allocates room, copies a stored blob in, and loads it
+// (parsed on the VM thread; the blob stays allocated for good).
+uintptr_t jitCacheAlloc(uint32 size)
+{
+	return reinterpret_cast<uintptr_t>(malloc(std::max<uint32>(size, 1)));
+}
+
+void jitCacheLoad(uintptr_t blob, uint32 size)
+{
+	g_virtualMachine->SendVmCall([blob, size]() { WsxJitCache::Load(reinterpret_cast<const uint8*>(blob), size); });
+}
+
+// Entries compiled since the last call, as a Uint8Array (empty when there are none).
+emscripten::val jitCacheTakeNew()
+{
+	auto pending = WsxJitCache::TakePending();
+	return emscripten::val::global("Uint8Array").new_(emscripten::typed_memory_view(pending.size(), pending.data()));
+}
+
+std::string jitCacheStats()
+{
+	auto& stats = WsxJitCache::g_stats;
+	char text[160];
+	snprintf(text, sizeof(text), "{\"loaded\":%u,\"hits\":%u,\"misses\":%u,\"mismatches\":%u}", stats.loaded, stats.hits, stats.misses, stats.mismatches);
+	return text;
+}
+
+// Verify mode: compile anyway and compare with the cached code (counts mismatches).
+void jitCacheSetVerify(bool verify)
+{
+	g_virtualMachine->SendVmCall([verify]() { WsxJitCache::g_verify = verify; });
+}
