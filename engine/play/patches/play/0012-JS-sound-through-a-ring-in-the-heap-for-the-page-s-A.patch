diff --git a/Source/ui_js/SH_WsxRing.cpp b/Source/ui_js/SH_WsxRing.cpp
new file mode 100644
index 00000000..5817f11b
--- /dev/null
+++ b/Source/ui_js/SH_WsxRing.cpp
@@ -0,0 +1,71 @@
+#include "SH_WsxRing.h"
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+CSH_WsxRing::RING* CSH_WsxRing::GetRing()
+{
+	//Allocated once, early (the page's views of the heap were made before any growth), never freed.
+	static RING* ring = []() {
+		size_t size = sizeof(RING) + (CAPACITY_FRAMES * 2 * sizeof(int16));
+		auto memory = static_cast<uint8*>(aligned_alloc(16, size));
+		memset(memory, 0, size);
+		auto result = new(memory) RING();
+		result->capacity = CAPACITY_FRAMES;
+		result->sampleRate = 44100;
+		return result;
+	}();
+	return ring;
+}
+
+CSH_WsxRing::CSH_WsxRing()
+{
+	GetRing();
+}
+
+CSoundHandler::FactoryFunction CSH_WsxRing::GetFactoryFunction(CSH_WsxRing* handler)
+{
+	return [handler]() { return handler; };
+}
+
+void CSH_WsxRing::Reset()
+{
+	//The worklet notices the jump and buffers up again.
+	auto ring = GetRing();
+	ring->writePos.store(ring->readPos.load());
+}
+
+void CSH_WsxRing::Write(int16* samples, unsigned int sampleCount, unsigned int sampleRate)
+{
+	auto ring = GetRing();
+	ring->sampleRate = sampleRate;
+	uint32 frames = sampleCount / 2;
+	uint32 writePos = ring->writePos.load(std::memory_order_relaxed);
+	uint32 readPos = ring->readPos.load(std::memory_order_acquire);
+	uint32 free = ring->capacity - (writePos - readPos);
+	if(frames > free)
+	{
+		//Nobody is listening (audio suspended): drop rather than overwrite what's being played.
+		ring->overflows.fetch_add(1, std::memory_order_relaxed);
+		frames = free;
+	}
+	auto data = reinterpret_cast<int16*>(ring + 1);
+	for(uint32 i = 0; i < frames;)
+	{
+		uint32 index = (writePos + i) % ring->capacity;
+		uint32 run = std::min<uint32>(frames - i, ring->capacity - index);
+		memcpy(data + (index * 2), samples + (i * 2), run * 2 * sizeof(int16));
+		i += run;
+	}
+	ring->writePos.store(writePos + frames, std::memory_order_release);
+}
+
+bool CSH_WsxRing::HasFreeBuffers()
+{
+	return true;
+}
+
+void CSH_WsxRing::RecycleBuffers()
+{
+}
diff --git a/Source/ui_js/SH_WsxRing.h b/Source/ui_js/SH_WsxRing.h
new file mode 100644
index 00000000..3997275e
--- /dev/null
+++ b/Source/ui_js/SH_WsxRing.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <atomic>
+#include "sound/SoundHandler.h"
+
+// Sound output for the browser: the VM thread writes samples into a ring in the wasm heap and an
+// AudioWorklet on the page (src/emu/ps2/audio.ts in WebStationX) plays them from the audio thread.
+// No main thread hops (the OpenAL path queued ~100 ms buffers through the page's main thread and
+// started playing with a single buffer queued, so any jitter left a gap).
+class CSH_WsxRing : public CSoundHandler
+{
+public:
+	//Layout read by the worklet: keep in sync with src/emu/ps2/audio.ts.
+	struct RING
+	{
+		std::atomic<uint32> writePos; //frames written (wraps at 2^32)
+		std::atomic<uint32> readPos;  //frames consumed, advanced by the worklet
+		uint32 capacity;              //frames
+		uint32 sampleRate;
+		std::atomic<uint32> overflows; //writes dropped because the ring was full (audio suspended)
+		uint32 reserved[3];
+		//int16 samples[capacity * 2] follow (interleaved stereo)
+	};
+
+	CSH_WsxRing();
+	virtual ~CSH_WsxRing() = default;
+
+	void Reset() override;
+	void Write(int16*, unsigned int, unsigned int) override;
+	bool HasFreeBuffers() override;
+	void RecycleBuffers() override;
+
+	static FactoryFunction GetFactoryFunction(CSH_WsxRing*);
+	static RING* GetRing();
+
+	enum
+	{
+		CAPACITY_FRAMES = 32768, //~0.75 s at 44.1 kHz
+	};
+};
