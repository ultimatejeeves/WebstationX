+	std::set<uint32> m_swDepthPtrs;
+	std::set<uint32> m_swDisplayedPtrs;
+	std::vector<SWCOPY> m_swCopies; //Recent copies out of our buffers into GS memory
+	uint32 m_swFlipCount = 0;
+	uint32 m_swLastFbPtr = ~0U;
+	uint32 m_swLastDisplayedPtr = ~0U;
