 }
 
+bool CGSH_OpenGL::IsSwSurface(uint32 ptr) const
+{
+	if(m_swTargets.empty()) return false;
+	return (m_swTargets.find(ptr) != m_swTargets.end()) || (m_swDepthPtrs.find(ptr) != m_swDepthPtrs.end());
+}
+
+void CGSH_OpenGL::SwNoteCopy(uint32 dstPtr, uint32 srcPtr)
+{
+	for(const auto& copy : m_swCopies)
+	{
+		if((copy.dstPtr == dstPtr) && (copy.srcPtr == srcPtr)) return;
+	}
+	if(m_swCopies.size() >= SW_COPY_MAX) m_swCopies.erase(m_swCopies.begin());
+	SWCOPY copy;
+	copy.dstPtr = dstPtr;
+	copy.srcPtr = srcPtr;
+	m_swCopies.push_back(copy);
+}
+
+//The game downloads pixels from srcPtr: what was drawn there (or copied there from a buffer we draw) is data
+//to it. Those targets are drawn in software from now on, where every bit is what the GS would have produced.
+void CGSH_OpenGL::SwNoteReadback(uint32 srcPtr)
+{
+	auto mark = [&](uint32 ptr) {
+		if(m_swDisplayedPtrs.find(ptr) != m_swDisplayedPtrs.end()) return;
+		bool isTarget = (m_swTargets.find(ptr) != m_swTargets.end());
+		if(!isTarget)
+		{
+			bool isFramebuffer = std::any_of(m_framebuffers.begin(), m_framebuffers.end(),
+			                                 [&](const FramebufferPtr& framebuffer) { return framebuffer->m_basePtr == ptr; });
+			if(!isFramebuffer) return;
+			FlushVertexBuffer();
+			m_renderState.isValid = false;
+		}
+		m_swTargets[ptr] = m_swFlipCount;
+	};
+	mark(srcPtr);
+	for(const auto& copy : m_swCopies)
+	{
+		if(copy.dstPtr == srcPtr) mark(copy.srcPtr);
+	}
+}
+
+void CGSH_OpenGL::SwDrawPrimitive()
+{
+	unsigned int context = m_PrimitiveMode.nContext;
+	auto frame = make_convertible<FRAME>(m_nReg[GS_REG_FRAME_1 + context]);
+	auto zbuf = make_convertible<ZBUF>(m_nReg[GS_REG_ZBUF_1 + context]);
+	auto offset = make_convertible<XYOFFSET>(m_nReg[GS_REG_XYOFFSET_1 + context]);
+
+	if(!m_swRaster) m_swRaster = std::make_unique<CGsSwRaster>(m_pRAM, m_pCLUT);
+	if(frame.GetBasePtr() != m_swLastFbPtr)
+	{
+		SwFlushDirty();
+		m_swLastFbPtr = frame.GetBasePtr();
+	}
+	if(!zbuf.nMask) m_swDepthPtrs.insert(zbuf.GetBasePtr());
+
+	m_swRaster->SetContext(m_nReg, m_PrimitiveMode);
+
+	auto makeVertex = [&](const VERTEX& source) {
+		auto xyz = make_convertible<XYZ>(source.position);
+		auto rgbaq = make_convertible<RGBAQ>(source.rgbaq);
+		auto st = make_convertible<ST>(source.st);
+		auto uv = make_convertible<UV>(source.uv);
+		CGsSwRaster::VERTEX vertex;
+		vertex.x = static_cast<int32>(xyz.nX) - static_cast<int32>(offset.nOffsetX);
+		vertex.y = static_cast<int32>(xyz.nY) - static_cast<int32>(offset.nOffsetY);
+		vertex.z = xyz.nZ;
+		vertex.rgba = static_cast<uint32>(source.rgbaq);
+		vertex.s = st.nS;
+		vertex.t = st.nT;
+		vertex.q = rgbaq.nQ;
+		vertex.u = uv.nU & 0x3FFF;
+		vertex.v = uv.nV & 0x3FFF;
+		vertex.fog = source.fog;
+		return vertex;
+	};
+
+	switch(m_primitiveType)
+	{
+	case PRIM_POINT:
+		m_swRaster->DrawPoint(makeVertex(m_VtxBuffer[0]));
+		break;
+	case PRIM_TRIANGLE:
+	case PRIM_TRIANGLESTRIP:
+	case PRIM_TRIANGLEFAN:
+		m_swRaster->DrawTriangle(makeVertex(m_VtxBuffer[2]), makeVertex(m_VtxBuffer[1]), makeVertex(m_VtxBuffer[0]));
+		break;
+	case PRIM_SPRITE:
+		m_swRaster->DrawSprite(makeVertex(m_VtxBuffer[1]), makeVertex(m_VtxBuffer[0]));
+		break;
+	default:
+		//Lines aren't drawn
+		break;
+	}
+	m_swDirtyPending = true;
+	g_wsxGsStats.swPrims.fetch_add(1, std::memory_order_relaxed);
+}
+
+//What the software rasterizer wrote may be a texture (or under a buffer) of ours
+void CGSH_OpenGL::SwFlushDirty()
+{
+	if(!m_swDirtyPending) return;
+	m_swDirtyPending = false;
+	auto dirty = m_swRaster->TakeDirty();
+	if(!dirty.any) return;
+	m_swRaster->InvalidateTextures();
+
+	auto invalidate = [&](uint32 ptr, uint32 psm) {
+		bool is16 = (psm == PSMCT16) || (psm == PSMCT16S) || (psm == PSMZ16) || (psm == PSMZ16S);
+		uint32 size = (dirty.maxY + 1) * (dirty.fbWidth * 64) * (is16 ? 2 : 4);
+		//Up to the end of the page the last row is in
+		size = (size + (CGsPixelFormats::PAGESIZE * dirty.fbWidth) + CGsPixelFormats::PAGESIZE - 1) & ~(CGsPixelFormats::PAGESIZE - 1);
+		m_textureCache.InvalidateRange(ptr, size);
+		for(const auto& framebuffer : m_framebuffers)
+		{
+			if(IsSwSurface(framebuffer->m_basePtr)) continue;
+			framebuffer->m_cachedArea.Invalidate(ptr, size);
+		}
+	};
+	invalidate(dirty.fbPtr, dirty.fbPsm);
+	if(dirty.zWritten) invalidate(dirty.zPtr, dirty.zPsm);
+	m_renderState.isTextureStateValid = false;
+	m_renderState.isFramebufferStateValid = false;
+}
+
 void CGSH_OpenGL::ProcessClutTransfer(uint32 csa, uint32)
 {
 	FlushVertexBuffer();
+	if(m_swRaster) m_swRaster->InvalidateTextures();
 	m_renderState.isTextureStateValid = false;
 	PalCache_Invalidate(csa);
 }
